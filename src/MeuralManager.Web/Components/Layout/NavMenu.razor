@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject ImageCacheManager ImageCache

<aside class="sidebar">
    <div class="brand">
        <BrandMark />
        <span class="brand-name">Meural Manager</span>
    </div>

    <nav class="nav-links">
        <NavLink href="/" Match="NavLinkMatch.All" class="nav-link">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="3.5" width="7.5" height="9" rx="1.5"/><rect x="13" y="3.5" width="7.5" height="5" rx="1.5"/><rect x="3.5" y="14.5" width="7.5" height="6" rx="1.5"/><rect x="13" y="10.5" width="7.5" height="10" rx="1.5"/><path d="M15.6 17.5v-1.5M17.9 17.5v-3.5"/></svg>
            <span>Dashboard</span>
        </NavLink>
        <NavLink href="/playlists" class="nav-link">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6.5h16M4 11.5h8.5M4 16.5h6"/><path d="M15 13v7l5.5-3.5Z"/></svg>
            <span>Playlists</span>
        </NavLink>
        <NavLink href="/all-pictures" class="nav-link">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7.5 7.5V6a2 2 0 0 1 2-2h9A2 2 0 0 1 20.5 6v8a2 2 0 0 1-2 2H17"/><rect x="3.5" y="8" width="13.5" height="12" rx="2"/><circle cx="8" cy="12.2" r="1.2"/><path d="m4.5 17.8 3.2-3 3 2.7 2-1.8 3.1 3.1"/></svg>
            <span>All Pictures</span>
        </NavLink>
        @if (ImmichEnabled)
        {
            <NavLink href="/immich" class="nav-link">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><g transform="rotate(45 12 12)"><ellipse cx="12" cy="6.3" rx="2.5" ry="3.4"/><ellipse cx="12" cy="6.3" rx="2.5" ry="3.4" transform="rotate(90 12 12)"/><ellipse cx="12" cy="6.3" rx="2.5" ry="3.4" transform="rotate(180 12 12)"/><ellipse cx="12" cy="6.3" rx="2.5" ry="3.4" transform="rotate(270 12 12)"/></g></svg>
                <span>Immich</span>
            </NavLink>
        }
        <NavLink href="/orphan-uploads" class="nav-link">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="4.5" width="17" height="15" rx="2" stroke-dasharray="3.2 2.6"/><circle cx="9" cy="9.7" r="1.4"/><path d="m4.5 17 4-3.8 3 2.6 2.4-2.2 4.6 4.4"/></svg>
            <span>Orphan Uploads</span>
        </NavLink>
        <NavLink href="/unused-galleries" class="nav-link">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6.5h16M4 11.5h8M4 16.5h5"/><circle cx="17.5" cy="16.5" r="3.6"/><path d="m15 19 5-5"/></svg>
            <span>Unused Playlists</span>
        </NavLink>
        <NavLink href="/settings" class="nav-link">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10.45 5.28 10.69 2.69H13.31L13.55 5.28A6.9 6.9 0 0 1 15.66 6.15L17.66 4.49 19.51 6.34 17.85 8.34A6.9 6.9 0 0 1 18.72 10.45L21.31 10.69V13.31L18.72 13.55A6.9 6.9 0 0 1 17.85 15.66L19.51 17.66 17.66 19.51 15.66 17.85A6.9 6.9 0 0 1 13.55 18.72L13.31 21.31H10.69L10.45 18.72A6.9 6.9 0 0 1 8.34 17.85L6.34 19.51 4.49 17.66 6.15 15.66A6.9 6.9 0 0 1 5.28 13.55L2.69 13.31V10.69L5.28 10.45A6.9 6.9 0 0 1 6.15 8.34L4.49 6.34 6.34 4.49 8.34 6.15A6.9 6.9 0 0 1 10.45 5.28Z"/><circle cx="12" cy="12" r="2.6"/></svg>
            <span>Settings</span>
        </NavLink>
        <NavLink href="/release-notes" class="nav-link">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 12.2V5.5A2 2 0 0 1 5.5 3.5h6.7a2 2 0 0 1 1.4.6l6.8 6.8a2 2 0 0 1 0 2.8l-6.7 6.7a2 2 0 0 1-2.8 0L4.1 13.6a2 2 0 0 1-.6-1.4Z"/><circle cx="8" cy="8" r="1.3"/></svg>
            <span>Release Notes</span>
        </NavLink>
    </nav>

    <div class="sidebar-footer">
        @if (_progress is { IsRunning: true } p)
        {
            <div class="image-cache-progress" title="Downloading your pictures for faster local access">
                <span class="image-cache-progress-label">Caching images… @p.Cached/@p.Total</span>
                <div class="image-cache-progress-bar">
                    <div class="image-cache-progress-fill" style="width:@(Percent(p))%"></div>
                </div>
            </div>
        }
        <div class="signed-in-as" title="@Email">
            <span class="avatar">@Initial</span>
            <span class="signed-in-email">@Email</span>
        </div>
        <button class="btn btn-ghost btn-sm btn-block" @onclick="OnSignOut">Sign out</button>
    </div>
</aside>

@code {
    [Parameter] public string? Email { get; set; }
    [Parameter] public EventCallback OnSignOut { get; set; }
    // Hidden entirely unless switched on in Settings - most people don't run Immich.
    [Parameter] public bool ImmichEnabled { get; set; }

    private string Initial => string.IsNullOrEmpty(Email) ? "?" : Email[..1].ToUpperInvariant();
    private ImageCacheProgress? _progress;

    protected override void OnInitialized()
    {
        ImageCache.Changed += HandleImageCacheChanged;
        RefreshProgress();
    }

    protected override void OnParametersSet() => RefreshProgress();

    private void HandleImageCacheChanged(string email)
    {
        if (email != Email)
            return;

        InvokeAsync(() =>
        {
            RefreshProgress();
            StateHasChanged();
        });
    }

    private void RefreshProgress() => _progress = string.IsNullOrEmpty(Email) ? null : ImageCache.GetProgress(Email);

    private static int Percent(ImageCacheProgress p) => p.Total == 0 ? 0 : (int)(100.0 * p.Cached / p.Total);

    public void Dispose() => ImageCache.Changed -= HandleImageCacheChanged;
}
