    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <title>Meural Manager</title>
    <base href="/" />
    <link rel="stylesheet" href="css/app.css?v=@AssetVersion.Get("css/app.css")" />
    <link rel="icon" href="data:," />
