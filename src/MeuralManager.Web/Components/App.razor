@using Microsoft.AspNetCore.Components.Web
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <title>Meural Manager</title>
    <base href="/" />
    @* Assets[...] resolves each file to its fingerprinted URL (see MapStaticAssets in Program.cs),
       so a new deployment never leaves a browser on a stale cached copy. *@
    @* Applies the theme this browser last used before the stylesheet paints, so a forced Dark or
       Light doesn't flash the system theme first (theme.js keeps it in sync with Settings). *@
    <script>try { var t = localStorage.getItem("meuralmanager.theme"); if (t) document.documentElement.setAttribute("data-theme", t); } catch (e) { }</script>
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>
<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["js/splitter.js"]"></script>
    <script src="@Assets["js/cropper.js"]"></script>
    <script src="@Assets["js/infinite-scroll.js"]"></script>
    <script src="@Assets["js/brand-motion.js"]"></script>
    <script src="@Assets["js/theme.js"]"></script>
    <script src="@Assets["js/reconnect.js"]"></script>
</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Everything is interactive except pages marked [ExcludeFromInteractiveRouting] (the Error
    // page), which render statically so they work even when the circuit is what failed.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? new InteractiveServerRenderMode(prerender: false) : null;
}
