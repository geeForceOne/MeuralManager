@using Microsoft.AspNetCore.Components.Web
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <title>Meural Manager</title>
    <base href="/" />
    @* Assets[...] resolves each file to its fingerprinted URL (see MapStaticAssets in Program.cs),
       so a new deployment never leaves a browser on a stale cached copy. *@
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <ImportMap />
    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
</head>
<body>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["js/splitter.js"]"></script>
    <script src="@Assets["js/cropper.js"]"></script>
    <script src="@Assets["js/infinite-scroll.js"]"></script>
    <script src="@Assets["js/brand-motion.js"]"></script>
</body>
</html>
