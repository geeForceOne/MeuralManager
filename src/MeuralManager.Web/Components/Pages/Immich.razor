    // The playlist's images in playlist order, from the scan's cache (so as fresh as the last scan
    // or app action - no Meural call). Rebuilt only when the playlist's id list or the item cache
    // is replaced, since render calls this every time.
    private List<MeuralItem> ExistingItems(MeuralGallery playlist)
    {
        var all = Session.AllItemsCache;
        if (_existingMemo is { } memo && ReferenceEquals(memo.ItemIds, playlist.ItemIds) && ReferenceEquals(memo.All, all))
            return memo.Items;

        var byId = (all ?? []).Where(i => i.Id.HasValue).ToDictionary(i => i.Id!.Value);
        var items = (playlist.ItemIds ?? [])
            .Select(id => byId.TryGetValue(id, out var item) ? item : null)
            .OfType<MeuralItem>()
            .ToList();
        _existingMemo = (playlist.ItemIds, all, items);
        return items;
    }

    private void PreviewExisting(MeuralItem item)
    {
        _previewItem = item;
        _previewAsset = null;
    }

    private void PreviewAsset(ImmichAsset asset)
    {
        _previewAsset = asset;
        _previewItem = null;
        // Also the anchor for a shift-click range, like the last photo clicked to select.
        _lastClickedId = asset.Id;
    }

    private void OnTileToggle((ImmichAsset Asset, bool Shift) args)
    {
        var (asset, shift) = args;

        // Shift-click selects everything between the last-clicked photo and this one, the same
        // as Immich's own grid (and most file managers).
        if (shift && _lastClickedId is not null)
        {
            var from = _assets.FindIndex(a => a.Id == _lastClickedId);
            var to = _assets.FindIndex(a => a.Id == asset.Id);
            if (from >= 0 && to >= 0)
            {
                var select = !_selectedIds.Contains(asset.Id);
                for (var i = Math.Min(from, to); i <= Math.Max(from, to); i++)
                    SetSelected(_assets[i], select);
                _lastClickedId = asset.Id;
                return;
            }
        }

        SetSelected(asset, !_selectedIds.Contains(asset.Id));
        _lastClickedId = asset.Id;
    }

    private void OnDayToggle((DateTime Day, bool Select) args)
    {
        foreach (var asset in _assets.Where(a => a.TakenDate == args.Day))
            SetSelected(asset, args.Select);
    }

    private void SetSelected(ImmichAsset asset, bool selected)
    {
        if (selected)
        {
            if (_selectedIds.Add(asset.Id))
                _selected.Add(asset);
        }
        else if (_selectedIds.Remove(asset.Id))
        {
            _selected.RemoveAll(a => a.Id == asset.Id);
            _names.Remove(asset.Id);
        }
    }

    private void ClearSelection()
    {
        _selected.Clear();
        _selectedIds.Clear();
        _names.Clear();
        _lastClickedId = null;
    }

    // Asks the given provider (regardless of the default in Settings - the basket shows one button
    // per configured provider) to name the photo, and fills the result into its name field. The
    // photo goes to the AI as Immich's ~1440px preview rendition - always a JPEG, and much lighter
    // than the original.
    private async Task SuggestNameAsync(ImmichAsset asset, AiProvider provider)
    {
        if (_immich is null || _busy || _suggestingId is not null)
            return;

        var aiSettings = (await Session.LoadAiSettingsAsync()) with { Provider = provider };
        if (!aiSettings.HasKeyFor(provider))
        {
            _toast.ShowError($"No API key configured for {provider} - add one in Settings.");
            return;
        }

        _suggestingId = asset.Id;
        _suggestingProvider = provider;
        try
        {
            _names[asset.Id] = await SuggestFromImmichAsync(asset, aiSettings, CancellationToken.None);
        }
        catch (AiNamingException ex)
        {
            _log.Append($"Couldn't suggest a name for \"{asset.OriginalFileName}\": {ex.Message}");
            _toast.ShowError(ex.Message);
        }
        catch (Exception ex)
        {
            _log.Append($"Couldn't suggest a name for \"{asset.OriginalFileName}\": {ex.Message}");
            _toast.ShowError($"Couldn't suggest a name: {ex.Message}");
        }
        finally
        {
            _suggestingId = null;
            _suggestingProvider = null;
        }
    }

    // Same, for the whole basket with the default provider, politely paced like the other bulk
    // AI/Meural loops. Only fills in the name fields - nothing is sent to Meural until Upload.
    private async Task AiRenameAllAsync()
    {
        if (_immich is null || _busy || _selected.Count == 0)
            return;

        var aiSettings = await Session.LoadAiSettingsAsync();
        if (!aiSettings.HasKeyFor(aiSettings.Provider))
        {
            _toast.ShowError($"No API key configured for {aiSettings.Provider} - add one in Settings.");
            return;
        }

        var assets = _selected.ToList();
        _busy = true;
        var cts = _cts = new CancellationTokenSource();
        try
        {
            _log.Append($"AI-naming {assets.Count} photo(s) with {aiSettings.Provider}...");
            int done = 0, failed = 0;
            for (var i = 0; i < assets.Count; i++)
            {
                var asset = assets[i];
                try
                {
                    _names[asset.Id] = await SuggestFromImmichAsync(asset, aiSettings, cts.Token);
                    done++;
                    StateHasChanged();
                }
                catch (AiNamingException ex)
                {
                    failed++;
                    _log.Append($"[{i + 1}/{assets.Count}] Couldn't suggest a name for \"{asset.OriginalFileName}\": {ex.Message}");
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    failed++;
                    _log.Append($"[{i + 1}/{assets.Count}] Couldn't suggest a name for \"{asset.OriginalFileName}\": {ex.Message}");
                }

                if (i < assets.Count - 1)
                    await Task.Delay(TimeSpan.FromMilliseconds(300), cts.Token);
            }

            _log.Append($"AI naming finished: {done} named, {failed} failed.");
            if (failed > 0)
                _toast.ShowError($"{failed} of {assets.Count} photo(s) couldn't be named.");
            else
                _toast.ShowSuccess($"Named {done} photo(s) - review them, then upload.");
        }
        catch (OperationCanceledException)
        {
            HandleCancellation(cts, "AI naming");
        }
        finally
        {
            _cts?.Dispose();
            _cts = null;
            _busy = false;
        }
    }

    private async Task<string> SuggestFromImmichAsync(ImmichAsset asset, AiSettings aiSettings, CancellationToken ct)
    {
        using var response = await _immich!.GetAssetThumbnailAsync(asset.Id, "preview", ct);
        var bytes = await response.Content.ReadAsByteArrayAsync(ct);
        var mediaType = response.Content.Headers.ContentType?.MediaType ?? "image/jpeg";
        return await ImageNamingService.SuggestNameAsync(aiSettings, bytes, mediaType, SelectedPlaylist?.Name, _log.AsProgress(), ct);
    }

    private async Task CreatePlaylistAsync()
    {
        var name = await _prompt.PromptAsync("New Playlist", "Playlist name:");
        if (string.IsNullOrWhiteSpace(name))
            return;

        _busy = true;
        try
        {
            var gallery = await Session.Client!.CreateGalleryAsync(name);
            await Session.AddGalleryAsync(gallery);
            _targetGalleryId = gallery.Id;
            _log.Append($"Created playlist \"{gallery.Name}\".");
        }
        catch (Exception ex)
        {
            _log.Append($"Couldn't create playlist: {ex.Message}");
            _toast.ShowError($"Couldn't create playlist: {ex.Message}");
        }
        finally
        {
            _busy = false;
        }
    }

    // What the crop dialog loads - the same JPEG/PNG (or converted JPEG) that "Upload as-is" would
    // download, via the thumbnail proxy so the API key stays server-side.
    private string ProxyImageUrl(ImmichAsset asset) =>
        $"immich-proxy/{_proxyToken}/image/{asset.Id}?mime={Uri.EscapeDataString(asset.OriginalMimeType ?? "")}";

    private async Task UploadSelectedAsync()
    {
        if (_immich is null || _busy || _selected.Count == 0)
            return;
        if (_targetGalleryId is not long galleryId || AllPlaylists.FirstOrDefault(p => p.Id == galleryId) is not { } playlist)
        {
            _toast.ShowError("Choose a playlist to upload into first.");
            return;
        }

        var assets = _selected.ToList();

        // Photos already sent from here (they wear the "On Meural" badge). Skipping them is the
        // usual intent, but re-uploading is legitimate too - e.g. the earlier copy was deleted from
        // Meural since - so it's a choice, and Cancel still means "don't do anything".
        var already = assets.Where(a => _uploadedIds.Contains(a.Id)).ToList();
        if (already.Count > 0)
        {
            var choice = await _confirm.AskChoiceAsync(
                "Already uploaded",
                $"{already.Count} of the {assets.Count} selected photo{(assets.Count == 1 ? " was" : "s were")} already uploaded to Meural from here. " +
                "Skip those, or upload them again?",
                "Skip those", "Upload again");
            if (choice == ConfirmDialog.ConfirmChoice.Cancel)
                return;

            if (choice == ConfirmDialog.ConfirmChoice.Primary)
            {
                assets.RemoveAll(a => _uploadedIds.Contains(a.Id));
                if (assets.Count == 0)
                {
                    _toast.ShowInfo("Nothing new to upload.");
                    return;
                }
            }
        }

        var tempDir = Path.Combine(Path.GetTempPath(), "meuralmanager-web-immich", Guid.NewGuid().ToString("N"));
        Directory.CreateDirectory(tempDir);
        var uploadPaths = new List<string>();
        var assetByPath = new Dictionary<string, ImmichAsset>();
        // Keyed by the path that actually gets uploaded, to a file holding that photo's pre-crop
        // bytes, so a cropped upload can be reverted later like any other cropped item.
        var originalByUploadPath = new Dictionary<string, string>();
        var prepFailures = 0;

        _busy = true;
        var cts = _cts = new CancellationTokenSource();
        try
        {
            _log.Append($"Fetching {assets.Count} photo(s) from Immich...");
            var cropping = _cropFeatureEnabled;
            // The crop dialog opens on the format of the frame(s) this playlist is installed on.
            var cropAspect = Session.GetCropSuggestion(galleryId).Aspect;
            for (var i = 0; i < assets.Count; i++)
            {
                cts.Token.ThrowIfCancellationRequested();
                var asset = assets[i];
                var label = asset.OriginalFileName ?? asset.Id;
                // The Meural item is named after the file, so the basket's name field decides it.
                var baseName = FileNaming.SanitizeFileName(NameFor(asset));
                try
                {
                    // Same crop dialog and skip/skip-all choices as uploading a local file from the
                    // Playlists page. Cancelling one photo's crop just leaves that photo out.
                    if (cropping)
                    {
                        var result = await _cropDialog.CropAsync(
                            ProxyImageUrl(asset), cropAspect, allowSkip: true, remainingCount: assets.Count - i);

                        if (result.Outcome == CropDialog.CropOutcome.Cancelled)
                        {
                            _log.Append($"Skipped \"{label}\".");
                            continue;
                        }

                        if (result.Outcome == CropDialog.CropOutcome.SkippedAll)
                            cropping = false;

                        if (result.Outcome == CropDialog.CropOutcome.Applied && result.CroppedPath is string croppedPath)
                        {
                            var assetDir = Path.Combine(tempDir, asset.Id);
                            Directory.CreateDirectory(assetDir);
                            // The crop dialog always exports JPEG.
                            var uploadPath = Path.Combine(assetDir, $"{baseName}.jpg");
                            File.Move(croppedPath, uploadPath, overwrite: true);
                            uploadPaths.Add(uploadPath);
                            assetByPath[uploadPath] = asset;

                            try
                            {
                                var original = await _immich.DownloadForUploadAsync(asset, Path.Combine(tempDir, "originals"), cts.Token);
                                originalByUploadPath[uploadPath] = original.FilePath;
                            }
                            catch (Exception ex) when (ex is not OperationCanceledException)
                            {
                                // The crop itself is fine - just no "Revert to original" for this one.
                                _log.Append($"Couldn't keep the original of \"{label}\" for Revert: {ex.Message}");
                            }

                            continue;
                        }
                    }

                    var download = await _immich.DownloadForUploadAsync(asset, tempDir, cts.Token);
                    var uploadFile = RenameForUpload(download.FilePath, baseName);
                    uploadPaths.Add(uploadFile);
                    assetByPath[uploadFile] = asset;
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    prepFailures++;
                    _log.Append($"Couldn't get \"{label}\" from Immich: {ex.Message}");
                }
            }

            if (uploadPaths.Count == 0)
            {
                if (prepFailures > 0)
                    _toast.ShowError($"Couldn't fetch {prepFailures} photo(s) from Immich - see the activity log.");
                return;
            }

            _log.Append($"Uploading {uploadPaths.Count} image(s) to \"{playlist.Name}\"...");
            var summary = await PlaylistService.UploadAndAddToGalleryAsync(
                Session.Client!, galleryId, uploadPaths, _log.AsProgress(), cts.Token, KnownItemIds);
            var failed = summary.Failed + prepFailures;
            _log.Append($"Finished: {summary.Done} uploaded, {failed} failed.");

            foreach (var (path, uploadedItem) in summary.Uploaded)
            {
                if (originalByUploadPath.TryGetValue(path, out var originalPath) && uploadedItem.Id is long newId)
                    Session.SaveUploadOriginal(newId, originalPath);
            }

            // Only the photos that made it are deselected and badged - a failed one stays selected
            // so fixing whatever went wrong and clicking Upload again is all it takes.
            var uploadedAssetIds = summary.Uploaded
                .Where(u => assetByPath.ContainsKey(u.FilePath))
                .Select(u => assetByPath[u.FilePath].Id)
                .ToList();
            foreach (var id in uploadedAssetIds)
            {
                _uploadedIds.Add(id);
                SetSelected(new ImmichAsset { Id = id }, false);
            }

            if (uploadedAssetIds.Count > 0)
                await Session.AddImmichUploadedAssetIdsAsync(uploadedAssetIds);

            var items = await Session.Client!.GetGalleryItemsAsync(galleryId, ct: cts.Token);
            await Session.SetGalleryItemsAsync(galleryId, items);

            if (failed > 0)
                _toast.ShowError($"{failed} photo(s) couldn't be uploaded - they're still selected so you can try again.");
            else
                _toast.ShowSuccess($"Uploaded {summary.Done} photo(s) to \"{playlist.Name}\".");
        }
        catch (OperationCanceledException)
        {
            HandleCancellation(cts, "Upload");
        }
        catch (Exception ex)
        {
            _log.Append($"Upload failed: {ex.Message}");
            _toast.ShowError($"Upload failed: {ex.Message}");
        }
        finally
        {
            try { Directory.Delete(tempDir, recursive: true); } catch (IOException) { }
            _cts?.Dispose();
            _cts = null;
            _busy = false;
        }
    }

    // Gives a downloaded photo the file name the basket chose - each asset has its own subfolder
    // (see ImmichApiClient.DownloadForUploadAsync), so this can't collide with another photo.
    private static string RenameForUpload(string path, string baseName)
    {
        var target = Path.Combine(Path.GetDirectoryName(path)!, baseName + Path.GetExtension(path));
        if (string.Equals(target, path, StringComparison.Ordinal))
            return path;

        File.Move(path, target, overwrite: true);
        return target;
    }

    private void Cancel() => _cts?.Cancel();

    // Distinguishes the user clicking Cancel from an HttpClient timeout firing on its own - the
    // latter is a real failure that deserves a toast, not a silent "Cancelled." nobody sees.
    private void HandleCancellation(CancellationTokenSource cts, string operation)
    {
        if (cts.Token.IsCancellationRequested)
        {
            _log.Append("Cancelled.");
            return;
        }

        _log.Append($"{operation} timed out.");
        _toast.ShowError($"{operation} timed out - the server took too long to respond.");
    }

    private void HandleLogChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _log.Changed -= HandleLogChanged;
        _splitterRef?.Dispose();
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
