@page "/immich"
@implements IDisposable
@inject MeuralSessionState Session
@inject UserPreferencesStore Preferences
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="page-header">
    <h1>Immich</h1>
    <p class="page-subtitle">Browse your Immich photos and send them to a Meural playlist.</p>
</div>

@if (!_ready)
{
    <div class="photo-loading"><span class="spinner spinner-inline"></span> Loading…</div>
}
else if (!Session.HasScanned)
{
    <p class="empty-state">Scan your account from the <a href="/">Dashboard</a> first.</p>
}
else if (_immich is null)
{
    <p class="empty-state">
        @(_connectionError ?? "Immich isn't set up yet.")
        Enter your server URL and API key in <a href="/settings">Settings</a>.
    </p>
}
else
{
    <div class="tab-bar" role="tablist">
        <button type="button" role="tab" class="tab @(_tab == Tab.Photos ? "active" : "")" @onclick="() => SwitchTabAsync(Tab.Photos)">Photos</button>
        <button type="button" role="tab" class="tab @(_tab == Tab.Albums ? "active" : "")" @onclick="() => SwitchTabAsync(Tab.Albums)">Albums</button>
        <button type="button" role="tab" class="tab @(_tab == Tab.People ? "active" : "")" @onclick="() => SwitchTabAsync(Tab.People)">People</button>
    </div>

    <div class="playlist-layout immich-layout" id="immichSplit">
    <div class="pane pane-browse">
    @if (_tab == Tab.Photos)
    {
        <div class="immich-filters">
            <label class="field">
                <span>From</span>
                <input type="date" class="text-input" @bind="_from" @bind:after="ReloadAsync" />
            </label>
            <label class="field">
                <span>To</span>
                <input type="date" class="text-input" @bind="_to" @bind:after="ReloadAsync" />
            </label>
            <label class="field immich-search-field">
                <span>Search <span class="muted">(describe what's in the photo)</span></span>
                <input class="text-input" @bind="_query" @bind:after="ReloadAsync" placeholder="e.g. beach at sunset" />
            </label>
            @if (_from is not null || _to is not null || !string.IsNullOrWhiteSpace(_query))
            {
                <button type="button" class="btn btn-ghost btn-sm" @onclick="ClearFiltersAsync">Clear filters</button>
            }
        </div>
    }
    else if (_tab == Tab.Albums && _openAlbum is null)
    {
        @if (_listError is not null)
        {
            <p class="immich-error">@_listError</p>
        }
        else if (_loadingList || _albums is null)
        {
            <div class="photo-loading"><span class="spinner spinner-inline"></span> Loading albums…</div>
        }
        else if (_albums.Count == 0)
        {
            <p class="empty-state">No albums found.</p>
        }
        else
        {
            <div class="immich-card-grid">
                @foreach (var album in _albums)
                {
                    <button type="button" class="immich-card" @key="album.Id" @onclick="() => OpenAlbumAsync(album)">
                        @if (album.AlbumThumbnailAssetId is { Length: > 0 } thumbId)
                        {
                            <img src="immich-proxy/@_proxyToken/asset/@thumbId/thumbnail" loading="lazy" alt="" />
                        }
                        else
                        {
                            <div class="thumb-placeholder"></div>
                        }
                        <span class="immich-card-name">@(album.AlbumName ?? "(untitled)")</span>
                        <span class="immich-card-meta muted">@album.AssetCount photo@(album.AssetCount == 1 ? "" : "s")</span>
                    </button>
                }
            </div>
        }
    }
    else if (_tab == Tab.People && _openPerson is null)
    {
        @if (_listError is not null)
        {
            <p class="immich-error">@_listError</p>
        }
        else if (_loadingList || _people is null)
        {
            <div class="photo-loading"><span class="spinner spinner-inline"></span> Loading people…</div>
        }
        else
        {
            var unnamedCount = _people.Count(p => !p.HasName);
            @if (unnamedCount > 0)
            {
                <label class="immich-toggle">
                    <input type="checkbox" @bind="_showUnnamed" />
                    <span>Show @unnamedCount unnamed face@(unnamedCount == 1 ? "" : "s")</span>
                </label>
            }

            var visiblePeople = _people.Where(p => p.HasName || _showUnnamed).ToList();
            @if (visiblePeople.Count == 0)
            {
                <p class="empty-state">No named people found.</p>
            }
            else
            {
                <div class="immich-card-grid immich-people-grid">
                    @foreach (var person in visiblePeople)
                    {
                        <button type="button" class="immich-card immich-person" @key="person.Id" @onclick="() => OpenPersonAsync(person)">
                            <img src="immich-proxy/@_proxyToken/person/@person.Id" loading="lazy" alt="" />
                            <span class="immich-card-name">@(person.HasName ? person.Name : "Unnamed")</span>
                        </button>
                    }
                </div>
            }
        }
    }

    @if (ShowingGrid)
    {
        @if (_tab != Tab.Photos)
        {
            <div class="immich-back-row">
                <button type="button" class="btn btn-ghost btn-sm" @onclick="BackToList">← @(_tab == Tab.Albums ? "All albums" : "All people")</button>
                <h2>@(_tab == Tab.Albums ? _openAlbum?.AlbumName : _openPerson?.Name)</h2>
            </div>
        }

        @if (_viewError is not null)
        {
            <p class="immich-error">@_viewError</p>
        }

        <ImmichPhotoGrid Photos="_assets" ProxyToken="@_proxyToken" Selected="_selectedIds" Uploaded="_uploadedIds"
                         Previewing="@_previewAsset?.Id"
                         Grouped="@(_tab != Tab.Photos || string.IsNullOrWhiteSpace(_query))"
                         HasMore="@(_nextPage is not null)" Loading="_loadingAssets"
                         OnPreview="PreviewAsset" OnToggle="OnTileToggle" OnToggleDay="OnDayToggle"
                         OnLoadMore="() => LoadAssetsAsync(reset: false)" />
    }
    </div>

    <div class="split-handle" data-resize="next" data-pane-key="basket"></div>

    <div class="pane pane-basket">
        <div class="basket-header">
            <h3 class="pane-preview-title">Upload basket</h3>
            <span class="basket-count">@_selected.Count</span>
            <div class="toolbar-spacer"></div>
            @if (_busy)
            {
                <span class="spinner spinner-inline" title="Working…"></span>
                <button type="button" class="btn btn-ghost btn-sm" @onclick="Cancel">Cancel</button>
            }
            @if (_selected.Count > 0)
            {
                @if (HasAiKey)
                {
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="AiRenameAllAsync" disabled="@_busy"
                            title="Suggest a name for every photo in the basket with the default AI provider from Settings">
                        AI rename all
                    </button>
                }
                <button type="button" class="btn btn-ghost btn-sm" @onclick="ClearSelection" disabled="@_busy">Clear</button>
            }
        </div>

        <div class="basket-scroll">
        @if (_selected.Count == 0)
        {
            <p class="empty-state">Nothing in the basket yet. Click ✓ on a photo (or shift-click for a range) to add it.</p>
        }
        else
        {
            <ul class="basket-list">
                @foreach (var asset in _selected)
                {
                    var taken = TakenLabel(asset);
                    <li class="basket-item @(_previewAsset?.Id == asset.Id ? "previewing" : "")" @key="asset.Id" @onclick="() => PreviewAsset(asset)">
                        <img class="basket-thumb" src="immich-proxy/@_proxyToken/asset/@asset.Id/thumbnail" loading="lazy" alt="" />
                        <div class="basket-item-body">
                            <input class="text-input basket-name" value="@NameFor(asset)" disabled="@_busy"
                                   aria-label="Name in Meural" title="The name this photo gets in Meural"
                                   @onclick:stopPropagation="true" @onchange="e => SetName(asset, e.Value?.ToString())" />
                            <div class="basket-item-meta muted" title="@asset.OriginalFileName">
                                @asset.OriginalFileName@(taken is null ? "" : $" · {taken}")@(_uploadedIds.Contains(asset.Id) ? " · On Meural" : "")
                            </div>
                        </div>
                        <div class="basket-item-actions" @onclick:stopPropagation="true">
                            @if (_aiSettings.HasKeyFor(AiProvider.Claude))
                            {
                                <button type="button" class="basket-btn" title="Suggest a name with Claude" disabled="@(_busy || _suggestingId == asset.Id)"
                                        @onclick="() => SuggestNameAsync(asset, AiProvider.Claude)">
                                    @if (_suggestingId == asset.Id && _suggestingProvider == AiProvider.Claude)
                                    {
                                        <span class="spinner spinner-inline"></span>
                                    }
                                    else
                                    {
                                        <span>C</span>
                                    }
                                </button>
                            }
                            @if (_aiSettings.HasKeyFor(AiProvider.ChatGpt))
                            {
                                <button type="button" class="basket-btn" title="Suggest a name with ChatGPT" disabled="@(_busy || _suggestingId == asset.Id)"
                                        @onclick="() => SuggestNameAsync(asset, AiProvider.ChatGpt)">
                                    @if (_suggestingId == asset.Id && _suggestingProvider == AiProvider.ChatGpt)
                                    {
                                        <span class="spinner spinner-inline"></span>
                                    }
                                    else
                                    {
                                        <span>G</span>
                                    }
                                </button>
                            }
                            <button type="button" class="basket-btn" title="Remove from basket" aria-label="Remove from basket"
                                    disabled="@_busy" @onclick="() => SetSelected(asset, false)">✕</button>
                        </div>
                    </li>
                }
            </ul>
        }

        @* Read-only look at what the chosen playlist already holds (from any source) - below the
           upload entries so the photos about to be sent stay on top. *@
        @if (_showExisting && SelectedPlaylist is { } existingPlaylist)
        {
            var existing = ExistingItems(existingPlaylist);
            <div class="basket-existing">
                <h4 class="basket-existing-title">Already in "@existingPlaylist.Name" <span class="muted">(@existing.Count)</span></h4>
                @if (existing.Count == 0)
                {
                    <p class="muted basket-hint">This playlist is empty.</p>
                }
                else
                {
                    <div class="basket-existing-grid">
                        @foreach (var item in existing)
                        {
                            <div class="basket-existing-tile @(_previewItem?.Id == item.Id ? "previewing" : "")" @key="item.Id"
                                 title="@item.Name" @onclick="() => PreviewExisting(item)">
                                <ItemImage Item="item" CssClass="basket-existing-thumb" />
                            </div>
                        }
                    </div>
                }
            </div>
        }
        </div>

        <div class="basket-footer">
            <div class="basket-footer-row">
                <select class="text-input immich-playlist-select" @bind="_targetGalleryId" disabled="@_busy" aria-label="Target playlist">
                    <option value="">Choose a playlist…</option>
                    @foreach (var playlist in AllPlaylists)
                    {
                        <option value="@playlist.Id">@(IsFavorite(playlist) ? "★ " : "")@playlist.Name</option>
                    }
                </select>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="CreatePlaylistAsync" disabled="@_busy">+ New</button>
            </div>
            <label class="immich-toggle">
                <input type="checkbox" @bind="_showExisting" disabled="@(_targetGalleryId is null)" />
                <span>Show what's already in this playlist</span>
            </label>
            @if (_cropFeatureEnabled)
            {
                <p class="muted basket-hint">@CropHint</p>
            }
            <button type="button" class="btn btn-primary" @onclick="UploadSelectedAsync"
                    disabled="@(_busy || _targetGalleryId is null || _selected.Count == 0)">
                Upload@(_selected.Count > 0 ? $" {_selected.Count}" : "") to playlist
            </button>
        </div>
    </div>

    <div class="split-handle" data-resize="next" data-pane-key="preview"></div>

    <div class="pane pane-preview">
        <h3 class="pane-preview-title">Preview</h3>
        @if (_previewItem is not null)
        {
            // An image already in the playlist (clicked in the basket's read-only list) - just
            // shown, nothing to do with it from here.
            <div class="preview-body">
                <div class="preview-image-wrap">
                    <ItemImage Item="_previewItem" CssClass="preview-image" />
                </div>
                <div class="preview-info">
                    <p class="preview-name">@(_previewItem.Name ?? "(untitled)")</p>
                    @if (!string.IsNullOrWhiteSpace(_previewItem.CreatedAt))
                    {
                        <p class="muted preview-meta">Uploaded @_previewItem.CreatedAt</p>
                    }
                    @if (SelectedPlaylist is { } previewPlaylist)
                    {
                        <p class="muted preview-meta">Already in "@previewPlaylist.Name"</p>
                    }
                </div>
            </div>
        }
        else if (_previewAsset is null)
        {
            <p class="empty-state">Click a photo to preview it</p>
        }
        else
        {
            var taken = TakenLabel(_previewAsset);
            <div class="preview-body">
                <div class="preview-image-wrap">
                    <img class="preview-image" src="immich-proxy/@_proxyToken/asset/@_previewAsset.Id/preview" alt="" />
                </div>
                <div class="preview-info">
                <p class="preview-name">@(_previewAsset.OriginalFileName ?? _previewAsset.Id)</p>
                @if (taken is not null)
                {
                    <p class="muted preview-meta">Taken @taken</p>
                }
                @if (_uploadedIds.Contains(_previewAsset.Id))
                {
                    <p class="muted preview-meta">Already uploaded to Meural from here</p>
                }
                <div class="preview-crop-actions">
                    @if (_selectedIds.Contains(_previewAsset.Id))
                    {
                        <button type="button" class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="() => SetSelected(_previewAsset, false)">Remove from basket</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => SetSelected(_previewAsset, true)">Add to basket</button>
                    }
                </div>
                </div>
            </div>
        }
    </div>
    </div>
}

@if (_log.Entries.Count > 0)
{
    <ActivityLogPanel Log="_log" />
}
<ConfirmDialog @ref="_confirm" />
<PromptDialog @ref="_prompt" />
<CropDialog @ref="_cropDialog" />
<Toast @ref="_toast" />

@code {
    private enum Tab { Photos, Albums, People }

    private Tab _tab = Tab.Photos;
    private bool _ready;
    private bool _busy;
    private bool _cropFeatureEnabled = true;
    private AiSettings _aiSettings = new();
    private ImmichApiClient? _immich;
    private string? _connectionError;
    private string _proxyToken = "";

    // The one photo list on screen, whichever tab it came from - the Photos timeline, an opened
    // album, or an opened person are all just a different filter over the same paged query.
    private readonly List<ImmichAsset> _assets = [];
    private int? _nextPage;
    private bool _loadingAssets;
    private string? _viewError;
    private CancellationTokenSource? _loadCts;

    private DateTime? _from;
    private DateTime? _to;
    private string? _query;

    private List<ImmichAlbum>? _albums;
    private ImmichAlbum? _openAlbum;
    private List<ImmichPerson>? _people;
    private ImmichPerson? _openPerson;
    private bool _showUnnamed;
    private bool _loadingList;
    private string? _listError;

    // Kept as a list (not just the id set) both to preserve pick order and because after a tab
    // switch the picked photos are no longer in _assets, but still need uploading.
    private readonly List<ImmichAsset> _selected = [];
    private readonly HashSet<string> _selectedIds = [];
    private string? _lastClickedId;
    private HashSet<string> _uploadedIds = [];
    private long? _targetGalleryId;

    // The photo shown in the preview pane - independent of the basket (a plain click previews,
    // it doesn't select), and kept across tab switches.
    private ImmichAsset? _previewAsset;

    // Or, instead, an image already in the target playlist - only one of the two is ever set.
    private MeuralItem? _previewItem;

    // Whether the basket also lists what the chosen playlist already holds (read-only), and the
    // last list built for it - see ExistingItems.
    private bool _showExisting;
    private (List<long>? ItemIds, List<MeuralItem>? All, List<MeuralItem> Items)? _existingMemo;

    // Names the user (or the AI) has chosen for basket photos, by Immich asset id. A photo without
    // an entry uses its filename - see NameFor. The chosen name is what the Meural item is called.
    private readonly Dictionary<string, string> _names = [];
    private string? _suggestingId;
    private AiProvider? _suggestingProvider;

    private DotNetObjectReference<Immich>? _splitterRef;
    private bool _splitterInit;

    private CancellationTokenSource? _cts;
    private readonly ActivityLog _log = new();
    private ConfirmDialog _confirm = null!;
    private PromptDialog _prompt = null!;
    private CropDialog _cropDialog = null!;
    private Toast _toast = null!;

    // Favorites float to the top, same as on the Playlists page, then everything else A-Z.
    private List<MeuralGallery> AllPlaylists =>
        (Session.AllGalleriesCache ?? [])
            .OrderByDescending(IsFavorite)
            .ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private bool IsFavorite(MeuralGallery gallery) => gallery.Id is long id && Session.FavoriteGalleryIds.Contains(id);

    private MeuralGallery? SelectedPlaylist => AllPlaylists.FirstOrDefault(p => p.Id == _targetGalleryId);

    private bool HasAiKey => _aiSettings.HasKeyFor(AiProvider.Claude) || _aiSettings.HasKeyFor(AiProvider.ChatGpt);

    // Says which crop format the dialog will open on for the chosen playlist, and why - see
    // MeuralSessionState.GetCropSuggestion.
    private string CropHint
    {
        get
        {
            if (_targetGalleryId is null)
                return "Choose a playlist - crops open on the format of the frames it's installed on (9:16 by default).";

            var suggestion = Session.GetCropSuggestion(_targetGalleryId);
            var format = suggestion.Orientation == FrameOrientation.Horizontal ? "16:9 (horizontal)" : "9:16 (vertical)";
            return suggestion.FrameNames.Count > 0
                ? $"Crops open as {format} - this playlist is on {string.Join(", ", suggestion.FrameNames)}."
                : $"Crops open as {format} - this playlist isn't installed on a frame yet.";
        }
    }

    private static string DefaultName(ImmichAsset asset) =>
        Path.GetFileNameWithoutExtension(asset.OriginalFileName ?? asset.Id);

    private string NameFor(ImmichAsset asset) => _names.TryGetValue(asset.Id, out var name) ? name : DefaultName(asset);

    private void SetName(ImmichAsset asset, string? value)
    {
        var name = value?.Trim();
        // Blank, or just the filename again, isn't a choice - fall back to the default.
        if (string.IsNullOrEmpty(name) || name == DefaultName(asset))
            _names.Remove(asset.Id);
        else
            _names[asset.Id] = name;
    }

    private static string? TakenLabel(ImmichAsset asset) =>
        (asset.LocalDateTime ?? asset.FileCreatedAt)?.ToString("ddd, MMM d, yyyy h:mm tt");

    // Snapshot of every upload id already known before an upload attempt - lets
    // UploadAndAddToGalleryAsync recognize a just-created item after a timeout.
    private HashSet<long> KnownItemIds =>
        (Session.AllItemsCache ?? []).Where(i => i.Id.HasValue).Select(i => i.Id!.Value).ToHashSet();

    private bool ShowingGrid =>
        _tab == Tab.Photos || (_tab == Tab.Albums && _openAlbum is not null) || (_tab == Tab.People && _openPerson is not null);

    private ImmichAssetFilter CurrentFilter => _tab switch
    {
        Tab.Albums when _openAlbum is not null => new ImmichAssetFilter { AlbumId = _openAlbum.Id },
        Tab.People when _openPerson is not null => new ImmichAssetFilter { PersonId = _openPerson.Id },
        _ => new ImmichAssetFilter
        {
            // Whole days, in the server's local time: "to" is inclusive, so it runs to the start
            // of the next day.
            TakenAfter = _from is DateTime from ? new DateTimeOffset(DateTime.SpecifyKind(from.Date, DateTimeKind.Local)) : null,
            TakenBefore = _to is DateTime to ? new DateTimeOffset(DateTime.SpecifyKind(to.Date.AddDays(1), DateTimeKind.Local)) : null,
            Query = _query,
        },
    };

    protected override async Task OnInitializedAsync()
    {
        _log.Changed += HandleLogChanged;

        var prefs = await Preferences.LoadAsync();
        if (!prefs.ImmichEnabled)
        {
            // Switched off in Settings - this page shouldn't be reachable by typing the URL either.
            Nav.NavigateTo("/", replace: true);
            return;
        }

        _cropFeatureEnabled = prefs.CropFeatureEnabled;
        _aiSettings = await Session.LoadAiSettingsAsync();

        try
        {
            _immich = await Session.GetImmichClientAsync();
        }
        catch (Exception ex)
        {
            _connectionError = $"Couldn't use the saved Immich settings: {ex.Message}";
        }

        // A saved key that can no longer be decrypted looks exactly like "not set up" here - say so.
        if (_immich is null && _connectionError is null && (await Session.GetUnreadableSecretsAsync()).Immich)
            _connectionError = "The saved Immich API key can't be read any more.";

        _proxyToken = Session.ImmichProxyToken ?? "";
        _uploadedIds = await Session.LoadImmichUploadedAssetIdsAsync();
        _ready = true;

        if (_immich is not null && Session.HasScanned)
            await LoadAssetsAsync(reset: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The three-pane layout only exists once Immich is connected, so this keeps trying after
        // each render until meuralSplitter.init finds the container.
        if (_splitterInit || !_ready || _immich is null || !Session.HasScanned)
            return;

        _splitterRef ??= DotNetObjectReference.Create(this);
        var prefs = await Preferences.LoadAsync();
        try
        {
            _splitterInit = await JS.InvokeAsync<bool>("meuralSplitter.init", "immichSplit", _splitterRef,
                new { basket = prefs.ImmichBasketPaneWidth, preview = prefs.ImmichPreviewPaneWidth });
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone.
        }
    }

    // Invoked by splitter.js once per drag so a pane's width survives a reload.
    [JSInvokable]
    public async Task OnSplitterResized(string paneKey, double width)
    {
        var prefs = await Preferences.LoadAsync();
        var updated = paneKey switch
        {
            "basket" => prefs with { ImmichBasketPaneWidth = width },
            "preview" => prefs with { ImmichPreviewPaneWidth = width },
            _ => prefs,
        };
        await Preferences.SaveAsync(updated);
    }

    private Task ReloadAsync() => LoadAssetsAsync(reset: true);

    private async Task ClearFiltersAsync()
    {
        _from = null;
        _to = null;
        _query = null;
        await LoadAssetsAsync(reset: true);
    }

    // Loads the next page of whatever CurrentFilter describes - or, with reset, starts over from
    // page one, cancelling any load still in flight so a slow, superseded response can't land on
    // top of the new view.
    private async Task LoadAssetsAsync(bool reset)
    {
        if (_immich is null)
            return;

        if (reset)
        {
            _loadCts?.Cancel();
            _loadCts?.Dispose();
            _loadCts = new CancellationTokenSource();
            _assets.Clear();
            _nextPage = 1;
            _viewError = null;
        }
        else if (_loadingAssets || _nextPage is null || _loadCts is null)
        {
            return;
        }

        var cts = _loadCts!;
        var page = _nextPage!.Value;
        _loadingAssets = true;
        StateHasChanged();
        try
        {
            var result = await _immich.SearchAssetsAsync(CurrentFilter, page, cts.Token);
            if (cts.IsCancellationRequested)
                return;

            _assets.AddRange(result.Assets);
            _nextPage = result.NextPage;
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            // Superseded by a newer load.
        }
        catch (Exception ex)
        {
            if (!cts.IsCancellationRequested)
            {
                _viewError = $"Couldn't load photos: {ex.Message}";
                _nextPage = null;
            }
        }
        finally
        {
            // A cancelled load must not clear the flag out from under the newer one that replaced it.
            if (!cts.IsCancellationRequested)
            {
                _loadingAssets = false;
                StateHasChanged();
            }
        }
    }

    private void CancelLoad()
    {
        _loadCts?.Cancel();
        _assets.Clear();
        _nextPage = null;
        _loadingAssets = false;
        _viewError = null;
    }

    private async Task SwitchTabAsync(Tab tab)
    {
        if (_tab == tab)
            return;

        _tab = tab;
        switch (tab)
        {
            case Tab.Photos:
                await LoadAssetsAsync(reset: true);
                break;
            case Tab.Albums when _openAlbum is not null:
            case Tab.People when _openPerson is not null:
                await LoadAssetsAsync(reset: true);
                break;
            case Tab.Albums:
                CancelLoad();
                await EnsureAlbumsAsync();
                break;
            case Tab.People:
                CancelLoad();
                await EnsurePeopleAsync();
                break;
        }
    }

    private async Task EnsureAlbumsAsync()
    {
        if (_albums is not null || _immich is null)
            return;

        _loadingList = true;
        _listError = null;
        StateHasChanged();
        try
        {
            _albums = (await _immich.GetAlbumsAsync()).OrderBy(a => a.AlbumName, StringComparer.OrdinalIgnoreCase).ToList();
        }
        catch (Exception ex)
        {
            _listError = $"Couldn't load albums: {ex.Message}";
        }
        finally
        {
            _loadingList = false;
        }
    }

    private async Task EnsurePeopleAsync()
    {
        if (_people is not null || _immich is null)
            return;

        _loadingList = true;
        _listError = null;
        StateHasChanged();
        try
        {
            // Named people first (alphabetical), then the unnamed faces Immich has clustered.
            _people = (await _immich.GetPeopleAsync())
                .OrderByDescending(p => p.HasName)
                .ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch (Exception ex)
        {
            _listError = $"Couldn't load people: {ex.Message}";
        }
        finally
        {
            _loadingList = false;
        }
    }

