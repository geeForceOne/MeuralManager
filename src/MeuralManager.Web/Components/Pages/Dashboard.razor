@page "/"
@using System.Reflection
@inject MeuralSessionState Session
@inject UserPreferencesStore Preferences

<div class="page-header">
    <h1>Meural Manager <span class="version-tag">v@(AppVersion)</span></h1>
</div>

<div class="scan-panel">
    <div class="scan-status">
        @if (Session.IsScanning)
        {
            <span class="spinner spinner-inline"></span>
            <span>Scanning your account…</span>
        }
        else if (Session.HasScanned)
        {
            <span>
                Last scanned @Session.LastScannedUtc!.Value.ToLocalTime().ToString("t") —
                @(Session.AllItemsCache?.Count ?? 0) upload(s), @(Session.AllGalleriesCache?.Count ?? 0) playlist(s),
                @(Session.AllDevicesCache?.Count ?? 0) frame(s).
            </span>
        }
        else
        {
            <span>Scan your account once to power the tools below - they all share this one scan.</span>
        }
    </div>
    <button class="btn btn-primary" @onclick="ScanAsync" disabled="@Session.IsScanning">
        @(Session.IsScanning ? "Scanning…" : Session.HasScanned ? "Rescan" : "Scan")
    </button>
</div>

<div class="card-grid">
    <a class="tool-card" href="/playlists">
        <svg class="tool-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 6.5a1.5 1.5 0 0 1 1.5-1.5h4l1.5 2h7.5A1.5 1.5 0 0 1 20 8.5v9A1.5 1.5 0 0 1 18.5 19h-13A1.5 1.5 0 0 1 4 17.5Z" stroke-linejoin="round"/></svg>
        <h2>Playlists</h2>
        <p>Browse every playlist, manage its images, upload new ones, and install a playlist on a frame.</p>
        <span class="tool-cta">Open playlist manager →</span>
    </a>
    <a class="tool-card" href="/all-pictures">
        <svg class="tool-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3.5" y="3.5" width="8" height="8" rx="1.5"/><rect x="12.5" y="3.5" width="8" height="8" rx="1.5"/><rect x="3.5" y="12.5" width="8" height="8" rx="1.5"/><rect x="12.5" y="12.5" width="8" height="8" rx="1.5"/></svg>
        <h2>All Pictures</h2>
        <p>Browse every uploaded image, rename it, search by name, and see which playlist(s) it's in.</p>
        <span class="tool-cta">Browse all pictures →</span>
    </a>
    <a class="tool-card" href="/orphan-uploads">
        <svg class="tool-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3.5" y="4.5" width="17" height="15" rx="2"/><circle cx="8.5" cy="9.5" r="1.5"/><path d="m4 16 4.5-4.5a1.5 1.5 0 0 1 2.1 0L15 16" stroke-linecap="round" stroke-linejoin="round"/><path d="m13 14 1.9-1.9a1.5 1.5 0 0 1 2.1 0L20 15" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <h2>Orphan Uploads</h2>
        <p>Find uploaded images that aren't in any playlist, back them up, and delete them from your account.</p>
        <span class="tool-cta">View orphans →</span>
    </a>
    <a class="tool-card" href="/unused-galleries">
        <svg class="tool-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M9 20h6M12 16v4" stroke-linecap="round"/></svg>
        <h2>Unused Playlists</h2>
        <p>Find playlists that aren't loaded on any Canvas frame, and back up or remove them.</p>
        <span class="tool-cta">View unused playlists →</span>
    </a>
</div>

@if (_showPictureOfTheMoment && _pictureItem is not null && !string.IsNullOrWhiteSpace(_pictureItem.Image))
{
    <div class="featured-picture">
        <ItemImage Item="_pictureItem" />
        <div class="featured-picture-caption">
            <span class="featured-picture-label">Picture of the Moment</span>
            <span class="featured-picture-name">@(_pictureItem.Name ?? "(untitled)")</span>
        </div>
    </div>
}

@code {
    private static readonly string AppVersion =
        Assembly.GetExecutingAssembly().GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion
        ?? "dev";

    private bool _showPictureOfTheMoment = true;
    private MeuralItem? _pictureItem;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var prefs = await Preferences.LoadAsync();
        _showPictureOfTheMoment = prefs.ShowPictureOfTheMoment;
        PickPicture();
        StateHasChanged();
    }

    private async Task ScanAsync()
    {
        await Session.ScanAsync();
        PickPicture();
    }

    private void PickPicture()
    {
        if (!_showPictureOfTheMoment || Session.AllItemsCache is not { Count: > 0 } items)
        {
            _pictureItem = null;
            return;
        }

        _pictureItem = items[Random.Shared.Next(items.Count)];
    }
}
