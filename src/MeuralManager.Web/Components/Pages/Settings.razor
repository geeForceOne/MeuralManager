@page "/settings"
@inject UserPreferencesStore Preferences
@inject MeuralSessionState Session

<div class="page-header" data-eyebrow="Preferences">
    <h1>Settings</h1>
</div>

<div class="settings-group">
    <h2>Dashboard</h2>
    <div class="setting-row">
        <div>
            <div class="setting-label">Picture of the Moment</div>
            <div class="muted setting-description">Show a random uploaded image on the Dashboard.</div>
        </div>
        <label class="switch">
            <input type="checkbox" checked="@_showPictureOfTheMoment" @onchange="OnToggleChanged" />
            <span class="switch-slider"></span>
        </label>
    </div>
</div>

<div class="settings-group">
    <h2>Cropping</h2>
    <div class="setting-row">
        <div>
            <div class="setting-label">Crop tool</div>
            <div class="muted setting-description">
                Crop images to 16:9/9:16 on upload or from an existing playlist image's preview.
            </div>
        </div>
        <label class="switch">
            <input type="checkbox" checked="@_cropFeatureEnabled" @onchange="OnCropToggleChanged" />
            <span class="switch-slider"></span>
        </label>
    </div>
    <p class="muted setting-description">
        Cropping is non-destructive - a "Revert to original" option lets you undo it later - but
        that only works because this app keeps a copy of the pre-crop image in its own local
        cache. <strong>If that cache (or its underlying database/volume) is lost or corrupted,
        those saved originals - and the ability to revert - are gone for good</strong>, even
        though the already-cropped image itself stays fine on Meural.
    </p>

    <h3 class="setting-subheading">Frames</h3>
    <p class="muted setting-description">
        Tell the app which way each frame hangs. When you add an image to a playlist, the crop tool
        opens on the format of the frame(s) that playlist is installed on - 9:16 if any of them is
        vertical, if you haven't set them, or if the playlist isn't on a frame yet. You can still
        switch format in the crop tool.
    </p>
    @if (!Session.HasScanned || Frames.Count == 0)
    {
        <p class="muted setting-description">
            @(Session.HasScanned ? "No frames found on this account." : "Scan your account from the Dashboard to list your frames.")
        </p>
    }
    else
    {
        @foreach (var frame in Frames)
        {
            var deviceId = frame.Id ?? 0;
            <div class="setting-row" @key="deviceId">
                <div>
                    <div class="setting-label">@(frame.Alias ?? $"Frame {deviceId}")</div>
                </div>
                <select class="text-input frame-orientation-select" aria-label="Orientation of @(frame.Alias ?? $"Frame {deviceId}")"
                        value="@OrientationOf(deviceId)" @onchange="e => OnFrameOrientationChanged(deviceId, e)">
                    <option value="@FrameOrientation.Vertical">9:16 (vertical)</option>
                    <option value="@FrameOrientation.Horizontal">16:9 (horizontal)</option>
                </select>
            </div>
        }
    }
</div>

<div class="settings-group">
    <h2>Frame Remote Control</h2>
    <div class="setting-row">
        <div>
            <div class="setting-label">Remote control toolbar</div>
            <div class="muted setting-description">
                Show a toolbar at the bottom of the app for controlling a Canvas frame directly -
                next/previous image, power, and switching its playlist.
            </div>
        </div>
        <label class="switch">
            <input type="checkbox" checked="@_remoteControlEnabled" @onchange="OnRemoteControlToggleChanged" />
            <span class="switch-slider"></span>
        </label>
    </div>
    <p class="muted setting-description">
        Unlike the rest of this app, these controls talk directly to the frame over your local
        network (not through Meural's cloud) - turn this off if the machine running this app
        can't reach your frame's local IP address.
    </p>
    <p class="muted setting-description">
        <strong>Your frame's local IP needs to stay fixed</strong> - set a DHCP reservation for
        it in your router. This app only learns a frame's IP from a full account scan, so if it
        changes afterward the toolbar will show that frame as unreachable until you rescan -
        rescanning from the Dashboard re-fetches each frame's current IP and fixes it.
    </p>
</div>

<div class="settings-group">
    <h2>Immich</h2>
    <div class="setting-row">
        <div>
            <div class="setting-label">Immich integration</div>
            <div class="muted setting-description">
                Browse your <a href="https://immich.app" target="_blank" rel="noopener">Immich</a> photo
                library (by date, album, or person) and upload photos straight into a Meural playlist.
                Leave this off if you don't use Immich - it hides the Immich page entirely.
            </div>
        </div>
        <label class="switch">
            <input type="checkbox" checked="@_immichEnabled" @onchange="OnImmichToggleChanged" />
            <span class="switch-slider"></span>
        </label>
    </div>

    @if (_immichEnabled)
    {
        <label class="field">
            <span>Server URL</span>
            <input class="text-input" autocomplete="off" @bind="_immichUrl" @bind:event="oninput" placeholder="http://192.168.1.10:2283" />
        </label>

        <label class="field">
            <span>API key</span>
            <input class="text-input" type="password" autocomplete="off" @bind="_immichKey" @bind:event="oninput" />
        </label>
        @if (_unreadable.Immich && string.IsNullOrEmpty(_immichKey))
        {
            <p class="immich-error">@UnreadableMessage("Immich")</p>
        }

        <p class="muted setting-description">
            Create the key in Immich under <em>Account Settings → API Keys</em>, and enable these
            permissions on it. They're all read-only - this app never changes anything in Immich:
        </p>
        <ul class="muted setting-description immich-permissions">
            <li><code>asset.read</code> - browse and search your photos</li>
            <li><code>asset.view</code> - show thumbnails and previews</li>
            <li><code>asset.download</code> - fetch the full photo to upload it to Meural</li>
            <li><code>album.read</code> - list your albums</li>
            <li><code>person.read</code> - list people and their face pictures</li>
            <li><code>user.read</code> - used by "Test connection" to confirm the key works</li>
        </ul>
        <p class="muted setting-description">
            The server needs to be reachable from the machine running this app (not just from your
            browser). The key stays on this server - your browser never sees it.
        </p>

        <div class="immich-settings-actions">
            <button type="button" class="btn btn-primary" @onclick="SaveImmichSettingsAsync" disabled="@(_savingImmich || _testingImmich)">
                @(_savingImmich ? "Saving…" : "Save")
            </button>
            <button type="button" class="btn btn-secondary" @onclick="TestImmichConnectionAsync"
                    disabled="@(_savingImmich || _testingImmich || string.IsNullOrWhiteSpace(_immichUrl) || string.IsNullOrWhiteSpace(_immichKey))">
                @(_testingImmich ? "Testing…" : "Test connection")
            </button>
            <button type="button" class="btn btn-ghost" @onclick="ClearImmichSettingsAsync" disabled="@(_savingImmich || _testingImmich)">
                Clear saved settings
            </button>
        </div>

        @if (_immichStatus is not null)
        {
            <p class="@(_immichStatusIsError ? "immich-error" : "muted")">@_immichStatus</p>
        }
    }
</div>

<div class="settings-group">
    <h2>AI Naming</h2>
    <p class="muted setting-description">
        On the Playlists page, get an AI-suggested name for an image (handy for uploads with a generic
        name like "IMG_1234"). Nothing is renamed automatically - you always review and can edit the
        suggestion before it's applied.
    </p>

    @* Shown whichever provider is selected below, since the fields for the other one are hidden. *@
    @if (_unreadable.Claude && string.IsNullOrEmpty(_claudeApiKey))
    {
        <p class="immich-error">@UnreadableMessage("Claude")</p>
    }
    @if (_unreadable.OpenAi && string.IsNullOrEmpty(_openAiApiKey))
    {
        <p class="immich-error">@UnreadableMessage("OpenAI")</p>
    }

    <label class="field">
        <span>Provider</span>
        <select class="text-input" @bind="_provider">
            <option value="@AiProvider.Claude">Claude</option>
            <option value="@AiProvider.ChatGpt">ChatGPT</option>
        </select>
    </label>

    @if (_provider == AiProvider.Claude)
    {
        <label class="field">
            <span>Claude API key</span>
            <input class="text-input" type="password" autocomplete="off" @bind="_claudeApiKey" @bind:event="oninput" placeholder="sk-ant-..." />
        </label>

        <label class="field">
            <span>Claude workspace ID <span class="muted">(only if you see a "workspace id is required" error)</span></span>
            <input class="text-input" autocomplete="off" @bind="_claudeWorkspaceId" @bind:event="oninput" placeholder="wrkspc_..." />
        </label>

        <label class="field">
            <span>Claude model</span>
            <input class="text-input" autocomplete="off" @bind="_claudeModel" @bind:event="oninput" placeholder="@AiSettings.DefaultClaudeModel" />
        </label>
    }
    else
    {
        <label class="field">
            <span>OpenAI API key</span>
            <input class="text-input" type="password" autocomplete="off" @bind="_openAiApiKey" @bind:event="oninput" placeholder="sk-..." />
        </label>

        <label class="field">
            <span>OpenAI model</span>
            <input class="text-input" autocomplete="off" @bind="_openAiModel" @bind:event="oninput" placeholder="@AiSettings.DefaultOpenAiModel" />
        </label>
    }

    <label class="field">
        <span>Rename style</span>
        <select class="text-input" @bind="_renameStyle">
            <option value="@RenameStyle.Professional">Professional - clear, descriptive</option>
            <option value="@RenameStyle.Creative">Creative - a bit playful or funny</option>
        </select>
    </label>

    <button type="button" class="btn btn-primary" @onclick="SaveAiSettingsAsync" disabled="@_savingAi">
        @(_savingAi ? "Saving…" : "Save AI settings")
    </button>
    @if (_aiSaved)
    {
        <span class="muted" style="margin-left: 10px;">Saved.</span>
    }
</div>

@code {
    private bool _showPictureOfTheMoment = true;
    private bool _cropFeatureEnabled = true;
    private bool _remoteControlEnabled = true;

    private bool _immichEnabled;
    private string _immichUrl = "";
    private string _immichKey = "";
    private bool _savingImmich;
    private bool _testingImmich;
    private string? _immichStatus;
    private bool _immichStatusIsError;

    private AiProvider _provider = AiProvider.Claude;
    private RenameStyle _renameStyle = RenameStyle.Professional;
    private string _claudeApiKey = "";
    private string _claudeWorkspaceId = "";
    private string _claudeModel = "";
    private string _openAiApiKey = "";
    private string _openAiModel = "";
    private bool _savingAi;
    private bool _aiSaved;

    // Saved keys that are still in the DB but can't be decrypted any more - their fields load empty,
    // so without this they'd just look like they'd vanished.
    private MeuralSessionState.UnreadableSecrets _unreadable = new(false, false, false);

    private static string UnreadableMessage(string what) =>
        $"A saved {what} API key exists but can't be read - the encryption key it was saved with is no longer available. Enter it again and save to replace it.";

    private async Task RefreshUnreadableAsync() => _unreadable = await Session.GetUnreadableSecretsAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var prefs = await Preferences.LoadAsync();
        _showPictureOfTheMoment = prefs.ShowPictureOfTheMoment;
        _cropFeatureEnabled = prefs.CropFeatureEnabled;
        _remoteControlEnabled = prefs.RemoteControlEnabled;
        _immichEnabled = prefs.ImmichEnabled;

        await RefreshUnreadableAsync();

        var immichSettings = await Session.LoadImmichSettingsAsync();
        _immichUrl = immichSettings.ServerUrl ?? "";
        _immichKey = immichSettings.ApiKey ?? "";

        var aiSettings = await Session.LoadAiSettingsAsync();
        _provider = aiSettings.Provider;
        _renameStyle = aiSettings.RenameStyle;
        _claudeApiKey = aiSettings.ClaudeApiKey ?? "";
        _claudeWorkspaceId = aiSettings.ClaudeWorkspaceId ?? "";
        _claudeModel = aiSettings.ClaudeModel ?? "";
        _openAiApiKey = aiSettings.OpenAiApiKey ?? "";
        _openAiModel = aiSettings.OpenAiModel ?? "";

        StateHasChanged();
    }

    private List<MeuralDevice> Frames => Session.AllDevicesCache ?? [];

    // A frame nobody has set yet is treated as vertical - see FrameOrientation.
    private FrameOrientation OrientationOf(long deviceId) =>
        Session.FrameOrientations.TryGetValue(deviceId, out var orientation) ? orientation : FrameOrientation.Vertical;

    private async Task OnFrameOrientationChanged(long deviceId, ChangeEventArgs e)
    {
        if (Enum.TryParse<FrameOrientation>(e.Value?.ToString(), out var orientation))
            await Session.SetFrameOrientationAsync(deviceId, orientation);
    }

    private async Task OnToggleChanged(ChangeEventArgs e)
    {
        _showPictureOfTheMoment = (bool)e.Value!;
        // Loads-then-patches (rather than constructing a fresh record) so this doesn't clobber
        // other preferences saved elsewhere, like the Playlists page's remembered splitter widths.
        var prefs = await Preferences.LoadAsync();
        await Preferences.SaveAsync(prefs with { ShowPictureOfTheMoment = _showPictureOfTheMoment });
    }

    private async Task OnCropToggleChanged(ChangeEventArgs e)
    {
        _cropFeatureEnabled = (bool)e.Value!;
        // Loads-then-patches so this doesn't clobber other preferences saved elsewhere - see
        // OnToggleChanged above.
        var prefs = await Preferences.LoadAsync();
        await Preferences.SaveAsync(prefs with { CropFeatureEnabled = _cropFeatureEnabled });
    }

    private async Task OnRemoteControlToggleChanged(ChangeEventArgs e)
    {
        _remoteControlEnabled = (bool)e.Value!;
        // Loads-then-patches so this doesn't clobber other preferences saved elsewhere - see
        // OnToggleChanged above.
        var prefs = await Preferences.LoadAsync();
        await Preferences.SaveAsync(prefs with { RemoteControlEnabled = _remoteControlEnabled });
    }

    private async Task OnImmichToggleChanged(ChangeEventArgs e)
    {
        _immichEnabled = (bool)e.Value!;
        _immichStatus = null;
        // Loads-then-patches so this doesn't clobber other preferences saved elsewhere - see
        // OnToggleChanged above.
        var prefs = await Preferences.LoadAsync();
        await Preferences.SaveAsync(prefs with { ImmichEnabled = _immichEnabled });

        // Switching it off stops the thumbnail proxy serving this account's Immich right away;
        // the saved URL and key are kept so switching it back on doesn't mean re-entering them.
        if (!_immichEnabled)
            Session.ReleaseImmichClient();
    }

    private async Task SaveImmichSettingsAsync()
    {
        _savingImmich = true;
        _immichStatus = null;
        try
        {
            await Session.SaveImmichSettingsAsync(new ImmichSettings { ServerUrl = _immichUrl, ApiKey = _immichKey });
            await RefreshUnreadableAsync();
            _immichStatus = "Saved.";
            _immichStatusIsError = false;
        }
        finally
        {
            _savingImmich = false;
        }
    }

    // Tests what's currently typed in the form, saved or not, so a bad URL or key can be fixed
    // before it's persisted.
    private async Task TestImmichConnectionAsync()
    {
        _testingImmich = true;
        _immichStatus = null;
        try
        {
            using var client = new ImmichApiClient(_immichUrl, _immichKey);
            var who = await client.TestConnectionAsync();
            _immichStatus = $"Connected to Immich as {who}.";
            _immichStatusIsError = false;
        }
        catch (Exception ex)
        {
            _immichStatus = ex is UriFormatException ? "That doesn't look like a valid server URL." : ex.Message;
            _immichStatusIsError = true;
        }
        finally
        {
            _testingImmich = false;
        }
    }

    private async Task ClearImmichSettingsAsync()
    {
        await Session.SaveImmichSettingsAsync(new ImmichSettings());
        await RefreshUnreadableAsync();
        _immichUrl = "";
        _immichKey = "";
        _immichStatus = "Cleared.";
        _immichStatusIsError = false;
    }

    private async Task SaveAiSettingsAsync()
    {
        _savingAi = true;
        _aiSaved = false;
        try
        {
            await Session.SaveAiSettingsAsync(new AiSettings
            {
                Provider = _provider,
                RenameStyle = _renameStyle,
                ClaudeApiKey = string.IsNullOrWhiteSpace(_claudeApiKey) ? null : _claudeApiKey.Trim(),
                ClaudeWorkspaceId = string.IsNullOrWhiteSpace(_claudeWorkspaceId) ? null : _claudeWorkspaceId.Trim(),
                ClaudeModel = string.IsNullOrWhiteSpace(_claudeModel) ? null : _claudeModel.Trim(),
                OpenAiApiKey = string.IsNullOrWhiteSpace(_openAiApiKey) ? null : _openAiApiKey.Trim(),
                OpenAiModel = string.IsNullOrWhiteSpace(_openAiModel) ? null : _openAiModel.Trim(),
            });
            await RefreshUnreadableAsync();
            _aiSaved = true;
        }
        finally
        {
            _savingAi = false;
        }
    }
}
