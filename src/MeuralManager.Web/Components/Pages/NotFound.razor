@page "/not-found"

@* Unknown addresses: the Router's NotFoundPage while navigating in the app, and what Program.cs
   re-executes to when a browser loads one directly. *@
<PageTitle>Not found · Meural Manager</PageTitle>

<div class="page-header">
    <h1>Not found</h1>
</div>

<div class="info-panel">
    <p>There's nothing at this address. The link may be wrong, or the page no longer exists.</p>
    <p class="not-found-actions"><a class="btn btn-secondary" href="">Back to Dashboard</a></p>
</div>
