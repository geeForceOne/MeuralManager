@page "/playlists"
@implements IDisposable
@inject MeuralSessionState Session
@inject IJSRuntime JS
@inject BackupArchiveService BackupArchive
@inject ImageCacheManager ImageCache
@inject UserPreferencesStore Preferences
@inject NavigationManager Nav

<div class="page-header">
    <h1>Playlists</h1>
    <p class="page-subtitle">Browse, create, and manage your Meural playlists.</p>
</div>

@if (!Session.HasScanned)
{
    <p class="empty-state">Scan your account from the <a href="/">Dashboard</a> first.</p>
}
else
{
    <div class="playlist-toolbar-bar">
        @if (_selectedPlaylist is null)
        {
            <p class="muted">Select a playlist to manage it.</p>
        }
        else
        {
            <h2 class="playlist-toolbar-title">@_selectedPlaylist.Name</h2>
            <span class="muted">@_selectedItems.Count item(s)@(_loadingItems ? " — loading…" : "")</span>
            @if (_busy)
            {
                <span class="spinner spinner-inline" title="Working…"></span>
                <button type="button" class="btn btn-ghost btn-sm" @onclick="Cancel">Cancel</button>
            }
            <div class="toolbar-spacer"></div>
            <div class="dropdown">
                <button type="button" class="btn btn-secondary btn-sm" @onclick="ToggleFrameMenu" disabled="@_busy">
                    Install on frame ▾
                </button>
                @if (_frameMenuOpen)
                {
                    <div class="dropdown-menu">
                        @if (FramesWithoutSelectedPlaylist.Count == 0)
                        {
                            <span class="dropdown-item disabled">@(Frames.Count == 0 ? "No frames found" : "Already on every frame")</span>
                        }
                        @foreach (var frame in FramesWithoutSelectedPlaylist)
                        {
                            <button type="button" class="dropdown-item" @onclick="() => InstallOnFrameAsync(frame)">
                                @(frame.Alias ?? $"Frame {frame.Id}")
                            </button>
                        }
                    </div>
                }
            </div>
            <div class="dropdown">
                <button type="button" class="btn btn-secondary btn-sm" @onclick="ToggleRemoveFrameMenu" disabled="@_busy">
                    Remove from frame ▾
                </button>
                @if (_removeFrameMenuOpen)
                {
                    <div class="dropdown-menu">
                        @if (FramesWithSelectedPlaylist.Count == 0)
                        {
                            <span class="dropdown-item disabled">Not on any frame</span>
                        }
                        @foreach (var frame in FramesWithSelectedPlaylist)
                        {
                            <button type="button" class="dropdown-item" @onclick="() => RemoveFromFrameAsync(frame)">
                                @(frame.Alias ?? $"Frame {frame.Id}")
                            </button>
                        }
                    </div>
                }
            </div>
            <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _showActivityLog = !_showActivityLog">
                @(_showActivityLog ? "Hide Activity Log" : "Activity Log")
            </button>
            <button type="button" class="btn btn-ghost btn-sm" @onclick="RenamePlaylistAsync" disabled="@_busy">Rename</button>
            <button type="button" class="btn btn-danger btn-sm" @onclick="DeletePlaylistAsync" disabled="@_busy">Delete</button>
        }
    </div>

    <div class="playlist-layout" id="playlistSplit">
        <div class="pane pane-list">
            <div class="pane-list-toolbar">
                <button type="button" class="btn btn-primary btn-sm" @onclick="CreatePlaylistAsync" disabled="@_busy">New</button>
                <input class="text-input" placeholder="Filter…" @bind="_filter" @bind:event="oninput" />
            </div>

            @{
                var playlists = FilteredSortedPlaylists;
                var frameNames = Session.GetFrameNamesByGallery();
            }

            <div class="table-wrap playlist-table-wrap">
                <table class="data-table playlist-table">
                    <thead>
                        <tr>
                            <th class="fav-col"></th>
                            <th class="sortable" @onclick="() => SortBy(SortColumn.Name)">Name@(SortIndicator(SortColumn.Name))</th>
                            <th class="sortable id-col" @onclick="() => SortBy(SortColumn.Items)">Items@(SortIndicator(SortColumn.Items))</th>
                            <th>Frames</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (playlists.Count == 0)
                        {
                            <tr><td colspan="4" class="empty-state">No playlists.</td></tr>
                        }
                        @foreach (var gallery in playlists)
                        {
                            var frames = gallery.Id is long gid && frameNames.TryGetValue(gid, out var names) && names.Count > 0
                                ? string.Join(", ", names)
                                : "—";
                            var isFavorite = IsFavorite(gallery);
                            <tr class="@(gallery.Id == _selectedPlaylist?.Id ? "selected" : "")" @onclick="() => SelectAsync(gallery)">
                                <td class="fav-col" @onclick:stopPropagation="true">
                                    <button type="button" class="fav-toggle @(isFavorite ? "is-favorite" : "")"
                                            title="@(isFavorite ? "Remove from favorites" : "Mark as favorite")"
                                            aria-label="@(isFavorite ? "Remove from favorites" : "Mark as favorite")"
                                            @onclick="() => ToggleFavoriteAsync(gallery)">
                                        ★
                                    </button>
                                </td>
                                <td class="playlist-name-cell" title="@gallery.Name">@(gallery.Name ?? "(untitled)")</td>
                                <td class="muted id-col">@(gallery.ItemIds?.Count ?? 0)</td>
                                <td class="muted frames-cell" title="@frames">@frames</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="split-handle"></div>

        <div class="pane pane-items">
            @if (_selectedPlaylist is null)
            {
                <p class="empty-state">Select a playlist on the left.</p>
            }
            else
            {
                <div class="items-toolbar">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="OpenAddExistingAsync" disabled="@_busy">
                        Add existing
                    </button>
                    <label class="btn btn-secondary btn-sm file-btn">
                        Upload new
                        <InputFile id="playlistUploadInput" OnChange="UploadNewAsync" multiple accept="image/*" disabled="@_busy" />
                    </label>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="ToggleSelectAll" disabled="@(_busy || _selectedItems.Count == 0)">
                        @(AllItemsSelected ? "Clear selection" : "Select all")
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="DeselectAll" disabled="@(_busy || _selectedItemIds.Count == 0)">
                        Deselect all
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="SelectNoName" disabled="@(_busy || !AnyGenericNamedItems)">
                        Select NoName
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="DownloadSelectedAsync" disabled="@(_busy || _selectedItemIds.Count == 0)">
                        Download selected (@_selectedItemIds.Count)
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="AiRenameSelectedAsync" disabled="@(_busy || _selectedItemIds.Count == 0)">
                        AI rename (@_selectedItemIds.Count)
                    </button>
                    <button type="button" class="btn btn-danger btn-sm" @onclick="RemoveSelectedAsync" disabled="@(_busy || _selectedItemIds.Count == 0)">
                        Remove selected (@_selectedItemIds.Count)
                    </button>
                    @if (_busy)
                    {
                        <span class="spinner spinner-inline"></span>
                        <button type="button" class="btn btn-ghost btn-sm" @onclick="Cancel">Cancel</button>
                    }
                </div>

                @if (_failedUploads.Count > 0 && _failedUploadsGalleryId == _selectedPlaylist.Id)
                {
                    <div class="failed-uploads-panel">
                        <div class="failed-uploads-header">
                            <span>@_failedUploads.Count upload(s) failed</span>
                            <div class="failed-uploads-actions">
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="RetryAllFailedUploadsAsync" disabled="@_busy">
                                    Retry all
                                </button>
                                <button type="button" class="btn btn-ghost btn-sm" @onclick="DismissFailedUploads" disabled="@_busy">
                                    Dismiss
                                </button>
                            </div>
                        </div>
                        <ul class="failed-uploads-list">
                            @foreach (var failure in _failedUploads)
                            {
                                <li>
                                    <span class="failed-upload-name">@failure.FileName</span>
                                    <span class="muted failed-upload-error" title="@failure.Error">@failure.Error</span>
                                    <button type="button" class="btn btn-ghost btn-sm" @onclick="() => RetryFailedUploadAsync(failure)" disabled="@_busy">
                                        Retry
                                    </button>
                                </li>
                            }
                        </ul>
                    </div>
                }

                @if (_loadingItems && _selectedItems.Count == 0)
                {
                    <div class="items-loading">
                        <span class="spinner"></span>
                        <p class="muted">Loading items…</p>
                    </div>
                }
                else if (_selectedItems.Count == 0)
                {
                    <p class="empty-state">This playlist is empty.</p>
                }
                else
                {
                    <div class="item-grid-wrap">
                        <div class="item-grid">
                            <Virtualize Items="ItemRows" Context="row" ItemSize="182">
                                <div class="item-grid-row">
                                    @foreach (var item in row)
                                    {
                                        var id = item.Id ?? 0;
                                        var nameLooksGeneric = FileNaming.LooksGeneric(item.Name);
                                        <div class="item-tile @(_selectedItemIds.Contains(id) ? "selected" : "") @(_previewItem?.Id == item.Id ? "previewing" : "") @(nameLooksGeneric ? "name-generic" : "")"
                                             @onclick="() => SetPreview(item)">
                                            <input type="checkbox" checked="@_selectedItemIds.Contains(id)"
                                                   @onclick:stopPropagation="true"
                                                   @onchange="e => ToggleItemSelection(id, (bool)e.Value!)" />
                                            @if (EditedItemIds.Contains(id))
                                            {
                                                <span class="item-tile-edited-badge" title="Cropped - original available (Revert in the preview pane)">
                                                    <svg width="11" height="11" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                        <rect x="2" y="5" width="14" height="8" rx="1.2" stroke="currentColor" stroke-width="2.2" />
                                                    </svg>
                                                </span>
                                            }
                                            @if (_aiSettings.HasKeyFor(AiProvider.Claude) || _aiSettings.HasKeyFor(AiProvider.ChatGpt))
                                            {
                                                <div class="item-tile-suggest-group" title="@(nameLooksGeneric ? "This name looks generic - suggest a name with AI" : "Suggest a name with AI")">
                                                    @if (_aiSettings.HasKeyFor(AiProvider.Claude))
                                                    {
                                                        <button type="button" class="item-tile-suggest-btn" title="Suggest a name with Claude"
                                                                disabled="@(_suggestingItemId == id)"
                                                                @onclick="() => SuggestNameAsync(item, AiProvider.Claude)" @onclick:stopPropagation="true">
                                                            @if (_suggestingItemId == id && _suggestingProvider == AiProvider.Claude)
                                                            {
                                                                <span class="spinner spinner-inline"></span>
                                                            }
                                                            else
                                                            {
                                                                <span class="item-tile-suggest-label">C</span>
                                                            }
                                                        </button>
                                                    }
                                                    @if (_aiSettings.HasKeyFor(AiProvider.ChatGpt))
                                                    {
                                                        <button type="button" class="item-tile-suggest-btn" title="Suggest a name with ChatGPT"
                                                                disabled="@(_suggestingItemId == id)"
                                                                @onclick="() => SuggestNameAsync(item, AiProvider.ChatGpt)" @onclick:stopPropagation="true">
                                                            @if (_suggestingItemId == id && _suggestingProvider == AiProvider.ChatGpt)
                                                            {
                                                                <span class="spinner spinner-inline"></span>
                                                            }
                                                            else
                                                            {
                                                                <span class="item-tile-suggest-label">G</span>
                                                            }
                                                        </button>
                                                    }
                                                </div>
                                            }
                                            <ItemImage Item="item" />
                                            <EditableItemName Item="item"
                                                              OnRenamed="updated => HandleItemRenamed(item, updated)"
                                                              OnRenameFailed="msg => HandleRenameFailed(msg)" />
                                        </div>
                                    }
                                </div>
                            </Virtualize>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="split-handle" data-resize="next"></div>

        <div class="pane pane-preview">
            <h3 class="pane-preview-title">Preview</h3>
            @if (_previewItem is null)
            {
                <p class="empty-state">Select an image to preview</p>
            }
            else
            {
                <div class="preview-body">
                    <ItemImage Item="_previewItem" CssClass="preview-image" />
                    <p class="preview-name">@(_previewItem.Name ?? "(untitled)")</p>
                    @if (!string.IsNullOrWhiteSpace(_previewItem.CreatedAt))
                    {
                        <p class="muted preview-meta">Uploaded @_previewItem.CreatedAt</p>
                    }
                    <div class="preview-crop-actions">
                        @if (_cropFeatureEnabled)
                        {
                            <button type="button" class="btn btn-secondary btn-sm btn-icon" disabled="@_busy"
                                    title="Crop to 16:9 (landscape)" aria-label="Crop to 16:9 landscape"
                                    @onclick="() => CropAndReplacePreviewAsync(CropDialog.CropAspect.Wide)">
                                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <rect x="2" y="5" width="14" height="8" rx="1.2" stroke="currentColor" stroke-width="1.6" />
                                </svg>
                            </button>
                            <button type="button" class="btn btn-secondary btn-sm btn-icon" disabled="@_busy"
                                    title="Crop to 9:16 (portrait)" aria-label="Crop to 9:16 portrait"
                                    @onclick="() => CropAndReplacePreviewAsync(CropDialog.CropAspect.Tall)">
                                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <rect x="5" y="2" width="8" height="14" rx="1.2" stroke="currentColor" stroke-width="1.6" />
                                </svg>
                            </button>
                        }
                        @if (_previewItem.Id is long previewId && Session.HasEditOriginal(previewId))
                        {
                            <button type="button" class="btn btn-ghost btn-sm" disabled="@_busy"
                                    title="Restore the original, uncropped version"
                                    @onclick="RevertPreviewToOriginalAsync">
                                Revert to original
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (_showActivityLog)
{
    <ActivityLogPanel Log="_log" />
}
<ConfirmDialog @ref="_confirm" />
<PromptDialog @ref="_prompt" />
<AddExistingItemsModal @ref="_picker" />
<CropDialog @ref="_cropDialog" />
<Toast @ref="_toast" />

@code {
    private enum SortColumn { Name, Items }

    // Matches .item-grid-row's fixed 5-column CSS grid - Virtualize needs a fixed-height row to
    // measure, which only works with a fixed column count (see app.css's .item-grid comment).
    private const int ItemGridColumns = 5;

    private MeuralGallery? _selectedPlaylist;
    private List<MeuralItem> _selectedItems = [];
    private readonly HashSet<long> _selectedItemIds = [];
    private MeuralItem? _previewItem;
    private bool _loadingItems;
    private bool _busy;
    private bool _frameMenuOpen;
    private bool _removeFrameMenuOpen;
    private bool _showActivityLog;
    private long? _suggestingItemId;
    private AiProvider? _suggestingProvider;
    private AiSettings _aiSettings = new();
    private string _filter = "";
    private SortColumn _sortColumn = SortColumn.Name;
    private bool _sortAscending = true;
    private CancellationTokenSource? _cts;
    private CancellationTokenSource? _selectCts;
    private readonly ActivityLog _log = new();
    private ConfirmDialog _confirm = null!;
    private PromptDialog _prompt = null!;
    private AddExistingItemsModal _picker = null!;
    private CropDialog _cropDialog = null!;
    private Toast _toast = null!;
    private DotNetObjectReference<Playlists>? _splitterRef;
    private bool _cropFeatureEnabled = true;

    private sealed record FailedUpload(string FileName, string FilePath, string Error);
    private long? _failedUploadsGalleryId;
    private string? _failedUploadsTempDir;
    private List<FailedUpload> _failedUploads = [];

    private MeuralApiClient Client => Session.Client!;
    private List<MeuralGallery> AllPlaylists => Session.AllGalleriesCache ?? [];
    private List<MeuralDevice> Frames => Session.AllDevicesCache ?? [];

    // Only frames the selected playlist isn't already loaded on - installing it again on a frame
    // that already has it is a no-op at best, so there's no reason to offer that choice.
    private List<MeuralDevice> FramesWithoutSelectedPlaylist =>
        _selectedPlaylist?.Id is not long galleryId ? Frames : Frames.Where(f => !IsOnFrame(f, galleryId)).ToList();

    // Only frames the selected playlist IS currently loaded on - the only ones it can be removed
    // from.
    private List<MeuralDevice> FramesWithSelectedPlaylist =>
        _selectedPlaylist?.Id is not long galleryId ? [] : Frames.Where(f => IsOnFrame(f, galleryId)).ToList();

    private bool IsOnFrame(MeuralDevice frame, long galleryId) =>
        frame.Id is long deviceId
        && Session.DeviceGalleriesCache is { } cache
        && cache.TryGetValue(deviceId, out var galleries)
        && galleries.Any(g => g.Id == galleryId);
    private List<MeuralItem[]> ItemRows => _selectedItems.Chunk(ItemGridColumns).ToList();
    private bool AllItemsSelected => _selectedItems.Count > 0 && _selectedItems.All(i => i.Id is long id && _selectedItemIds.Contains(id));
    private bool AnyGenericNamedItems => _selectedItems.Any(i => FileNaming.LooksGeneric(i.Name));
    private bool IsFavorite(MeuralGallery gallery) => gallery.Id is long id && Session.FavoriteGalleryIds.Contains(id);

    // Snapshot of every upload id already known before an upload attempt - passed to
    // UploadAndAddToGalleryAsync so it can recognize a just-created item after a timeout (one
    // that wasn't in this set is new, and might be the file that just "failed").
    private HashSet<long> KnownItemIds =>
        (Session.AllItemsCache ?? []).Where(i => i.Id.HasValue).Select(i => i.Id!.Value).ToHashSet();
    private HashSet<long> EditedItemIds => Session.GetEditedItemIds();

    private List<MeuralGallery> FilteredSortedPlaylists
    {
        get
        {
            IEnumerable<MeuralGallery> query = AllPlaylists;
            if (!string.IsNullOrWhiteSpace(_filter))
                query = query.Where(p => (p.Name ?? "").Contains(_filter, StringComparison.OrdinalIgnoreCase));

            // Favorites always float to the top, regardless of sort column/direction - the
            // chosen sort only decides ordering within the favorite and non-favorite groups.
            var ordered = _sortColumn switch
            {
                SortColumn.Items => _sortAscending
                    ? query.OrderByDescending(IsFavorite).ThenBy(p => p.ItemIds?.Count ?? 0)
                    : query.OrderByDescending(IsFavorite).ThenByDescending(p => p.ItemIds?.Count ?? 0),
                _ => _sortAscending
                    ? query.OrderByDescending(IsFavorite).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
                    : query.OrderByDescending(IsFavorite).ThenByDescending(p => p.Name, StringComparer.OrdinalIgnoreCase),
            };

            return ordered.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _log.Changed += HandleLogChanged;
        // Loaded once up front (rather than per-click) so the tile grid can decide which of the
        // two AI suggest buttons to show without an async round trip per tile.
        _aiSettings = await Session.LoadAiSettingsAsync();
        _cropFeatureEnabled = (await Preferences.LoadAsync()).CropFeatureEnabled;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _splitterRef = DotNetObjectReference.Create(this);
        var prefs = await Preferences.LoadAsync();
        await JS.InvokeVoidAsync("meuralSplitter.init", "playlistSplit", _splitterRef,
            new { list = prefs.PlaylistListPaneWidth, preview = prefs.PreviewPaneWidth });
    }

    // Invoked by splitter.js once per drag (on mouseup, not per mousemove) so a pane's width
    // survives a reload - see UserPreferencesStore.StoredPreferences.
    [JSInvokable]
    public async Task OnSplitterResized(string paneKey, double width)
    {
        var prefs = await Preferences.LoadAsync();
        var updated = paneKey switch
        {
            "list" => prefs with { PlaylistListPaneWidth = width },
            "preview" => prefs with { PreviewPaneWidth = width },
            _ => prefs,
        };
        await Preferences.SaveAsync(updated);
    }

    private void SortBy(SortColumn column)
    {
        if (_sortColumn == column) _sortAscending = !_sortAscending;
        else { _sortColumn = column; _sortAscending = true; }
    }

    private string SortIndicator(SortColumn column) =>
        _sortColumn != column ? "" : _sortAscending ? " ▲" : " ▼";

    private async Task SelectAsync(MeuralGallery gallery)
    {
        // Cancels any reload still in flight for a previously-selected playlist, so switching
        // playlists quickly can't have a slow, superseded request win the race and overwrite
        // what's on screen with the wrong playlist's items after the fact.
        _selectCts?.Cancel();
        _selectCts?.Dispose();
        var cts = _selectCts = new CancellationTokenSource();

        CleanupFailedUploadsTempDir();
        _selectedPlaylist = gallery;
        // Show what the shared account-wide cache already knows about this playlist's items
        // instantly, instead of blanking the grid while ReloadSelectedItemsAsync below re-fetches
        // the authoritative list from the API - selecting a playlist you've already scanned
        // shouldn't feel like a network round trip.
        _selectedItems = GetCachedItems(gallery);
        _selectedItemIds.Clear();
        _previewItem = null;
        _frameMenuOpen = false;
        _removeFrameMenuOpen = false;
        if (gallery.Id is not long galleryId)
            return;
        await ReloadSelectedItemsAsync(galleryId, cts.Token);
    }

    private async Task ToggleFavoriteAsync(MeuralGallery gallery)
    {
        if (gallery.Id is not long id)
            return;

        await Session.SetGalleryFavoriteAsync(id, !IsFavorite(gallery));
    }

    private List<MeuralItem> GetCachedItems(MeuralGallery gallery)
    {
        if (gallery.ItemIds is not { Count: > 0 } itemIds || Session.AllItemsCache is not { Count: > 0 } allItems)
            return [];

        var byId = allItems.Where(i => i.Id.HasValue).ToDictionary(i => i.Id!.Value);
        return itemIds.Where(byId.ContainsKey).Select(id => byId[id]).ToList();
    }

    private async Task ReloadSelectedItemsAsync(long galleryId, CancellationToken ct = default)
    {
        _loadingItems = true;
        try
        {
            var items = await Client.GetGalleryItemsAsync(galleryId, ct: ct);

            // A newer SelectAsync call may have cancelled this token but let a response that was
            // already in flight land anyway - don't let a slow, superseded reload apply its
            // (wrong-playlist) results on top of whatever's now selected.
            if (ct.IsCancellationRequested)
                return;

            _selectedItems = items;
            await Session.SetGalleryItemsAsync(galleryId, items);
            _selectedPlaylist = AllPlaylists.FirstOrDefault(p => p.Id == galleryId) ?? _selectedPlaylist;
        }
        catch (OperationCanceledException)
        {
            // Superseded by selecting a different playlist - not a real failure.
        }
        catch (Exception ex)
        {
            _log.Append($"Couldn't load items for \"{_selectedPlaylist?.Name}\": {ex.Message}");
            _toast.ShowError($"Couldn't load items for \"{_selectedPlaylist?.Name}\": {ex.Message}");
        }
        finally
        {
            // Same reasoning as above - a cancelled, superseded reload must not clear the loading
            // flag out from under the newer request that's still legitimately in progress.
            if (!ct.IsCancellationRequested)
                _loadingItems = false;
        }
    }

    private async Task CreatePlaylistAsync()
    {
        var name = await _prompt.PromptAsync("New Playlist", "Playlist name:");
        if (string.IsNullOrWhiteSpace(name))
            return;

        _busy = true;
        var cts = _cts = new CancellationTokenSource();
        MeuralGallery? created = null;
        try
        {
            var gallery = await Client.CreateGalleryAsync(name, cts.Token);
            _log.Append($"Created playlist \"{gallery.Name}\".");
            await Session.AddGalleryAsync(gallery);
            created = gallery;
        }
        catch (OperationCanceledException)
        {
            HandleCancellation(cts, "Creating the playlist");
        }
        catch (Exception ex)
        {
            _log.Append($"Couldn't create playlist: {ex.Message}");
            _toast.ShowError($"Couldn't create playlist: {ex.Message}");
        }
        finally
        {
            _cts?.Dispose();
            _cts = null;
            _busy = false;
        }

        // Runs as a fully separate step, after the create operation's own busy/cancellation
        // scope has closed out - matching exactly how selecting a playlist by clicking its row
        // already works, instead of nesting it inside CreatePlaylistAsync's still-active _busy
        // and _cts (the one path that was structurally different from the always-working one).
        if (created is not null)
            await SelectAsync(created);
    }

    private async Task RenamePlaylistAsync()
    {
        if (_selectedPlaylist?.Id is not long galleryId)
            return;

        var name = await _prompt.PromptAsync("Rename Playlist", "Playlist name:", _selectedPlaylist.Name ?? "");
        if (string.IsNullOrWhiteSpace(name))
            return;

        _busy = true;
        var cts = _cts = new CancellationTokenSource();
        try
        {
            var updated = await Client.RenameGalleryAsync(galleryId, name, cts.Token);
            _log.Append($"Renamed playlist to \"{updated.Name}\".");
            await Session.RenameGalleryAsync(galleryId, updated.Name);
