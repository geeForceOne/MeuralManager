    private void SetPreview(MeuralItem item) => _previewItem = item;

    // Meural has no "replace this item's image" endpoint (see PlaylistService.ReplaceItemImageAsync),
    // so this uploads the cropped result as a new item, re-adds it to every playlist the original
    // belonged to, and deletes the original - then reloads the current playlist's items from the
    // API so the grid/preview reflect the swap. Other playlists the original item was also in stay
    // correct membership-wise (RemoveItemsAsync below purges the old id everywhere), but won't show
    // the new item in their own cached grid until the next full rescan.
    private async Task CropAndReplacePreviewAsync(CropDialog.CropAspect aspect)
    {
        if (_previewItem is not { Id: long oldId } item || string.IsNullOrEmpty(Session.Email))
            return;

        var imageUrl = $"/image-cache/{Uri.EscapeDataString(Session.Email)}/{oldId}";
        var result = await _cropDialog.CropAsync(imageUrl, aspect);
        if (result.Outcome != CropDialog.CropOutcome.Applied || result.CroppedPath is not string croppedPath)
            return;

        _busy = true;
        var cts = _cts = new CancellationTokenSource();
        try
        {
            var galleryIds = AllPlaylists
                .Where(g => g.Id.HasValue && (g.ItemIds?.Contains(oldId) ?? false))
                .Select(g => g.Id!.Value)
                .ToList();

            // Makes this crop revertible: if oldId is already a crop of something, its stored
            // original gets carried forward below (RecordCropOriginal); otherwise its current
            // (pre-crop) bytes need grabbing now, from the local image cache, since oldId's
            // image is about to be deleted from Meural entirely.
            var freshOriginalPath = Session.HasEditOriginal(oldId)
                ? null
                : await ImageCache.GetOrDownloadImageAsync(Session.Email, oldId, cts.Token);

            _log.Append($"Cropping and replacing \"{item.Name}\"...");
            var newItem = await PlaylistService.ReplaceItemImageAsync(Client, item, galleryIds, croppedPath, _log.AsProgress(), cts.Token);

            if (newItem.Id is long newId)
                Session.RecordCropOriginal(oldId, newId, freshOriginalPath);

            await Session.RemoveItemsAsync([oldId]);

            if (_selectedPlaylist?.Id is long galleryId)
                await ReloadSelectedItemsAsync(galleryId, cts.Token);

            _previewItem = _selectedItems.FirstOrDefault(i => i.Id == newItem.Id) ?? newItem;
            _toast.ShowSuccess("Image replaced.");
        }
        catch (OperationCanceledException)
        {
            HandleCancellation(cts, "Cropping");
        }
        catch (Exception ex)
        {
            _log.Append($"Couldn't replace \"{item.Name}\": {ex.Message}");
            _toast.ShowError($"Couldn't replace \"{item.Name}\": {ex.Message}");
        }
        finally
        {
            try { File.Delete(croppedPath); } catch (IOException) { }
            _cts?.Dispose();
            _cts = null;
            _busy = false;
        }
    }

    // The reverse of CropAndReplacePreviewAsync: re-uploads the locally-stored pre-crop
    // original as a new item (via the same ReplaceItemImageAsync shape, just with the original
    // as the source file), swaps it into the same playlists, and deletes the cropped item -
    // then clears the now-consumed stored original, since the restored item is back to a clean,
    // un-edited state with nothing left to revert.
    private async Task RevertPreviewToOriginalAsync()
    {
        if (_previewItem is not { Id: long currentId } item)
            return;

        var originalPath = Session.GetEditOriginalPath(currentId);
        if (originalPath is null)
            return;

        if (!await _confirm.AskAsync(
            "Revert to original?",
            $"Restore the original, uncropped version of \"{item.Name}\"? The current (cropped) version will be deleted.",
            "Revert"))
            return;

        _busy = true;
        var cts = _cts = new CancellationTokenSource();
        try
        {
            var galleryIds = AllPlaylists
                .Where(g => g.Id.HasValue && (g.ItemIds?.Contains(currentId) ?? false))
                .Select(g => g.Id!.Value)
                .ToList();

            _log.Append($"Restoring the original version of \"{item.Name}\"...");
            var restoredItem = await PlaylistService.ReplaceItemImageAsync(Client, item, galleryIds, originalPath, _log.AsProgress(), cts.Token);
            Session.ClearEditOriginal(currentId);
            await Session.RemoveItemsAsync([currentId]);

            if (_selectedPlaylist?.Id is long galleryId)
                await ReloadSelectedItemsAsync(galleryId, cts.Token);

            _previewItem = _selectedItems.FirstOrDefault(i => i.Id == restoredItem.Id) ?? restoredItem;
            _toast.ShowSuccess("Reverted to the original image.");
        }
        catch (OperationCanceledException)
        {
            HandleCancellation(cts, "Reverting");
        }
        catch (Exception ex)
        {
            _log.Append($"Couldn't revert \"{item.Name}\": {ex.Message}");
            _toast.ShowError($"Couldn't revert \"{item.Name}\": {ex.Message}");
        }
        finally
        {
            _cts?.Dispose();
            _cts = null;
            _busy = false;
        }
    }

    private void HandleItemRenamed(MeuralItem oldItem, MeuralItem updated)
    {
        var idx = _selectedItems.FindIndex(i => i.Id == oldItem.Id);
        if (idx >= 0)
            _selectedItems[idx] = _selectedItems[idx] with { Name = updated.Name };
        if (_previewItem is not null && _previewItem.Id == oldItem.Id)
            _previewItem = _previewItem with { Name = updated.Name };

        _log.Append($"Renamed \"{oldItem.Name}\" to \"{updated.Name}\".");
    }

    private void HandleRenameFailed(string message)
    {
        _log.Append($"Couldn't rename image: {message}");
        _toast.ShowError($"Couldn't rename image: {message}");
    }

    // Asks the given provider (bypassing whatever's set as the default in Settings - the tile
    // shows one button per provider so either can be used with a single click regardless of
    // which is configured as default) for a name suggestion and applies it directly - no review
    // step, same as the toolbar's AI rename.
    private async Task SuggestNameAsync(MeuralItem item, AiProvider provider)
    {
        if (item.Id is not long itemId)
            return;

        if (string.IsNullOrWhiteSpace(item.Image))
        {
            _toast.ShowError("This image has no source URL to analyze.");
            return;
        }

        var aiSettings = (await Session.LoadAiSettingsAsync()) with { Provider = provider };
        if (!aiSettings.HasKeyFor(provider))
        {
            _toast.ShowError($"No API key configured for {provider} - add one in Settings.");
            return;
        }

        _suggestingItemId = itemId;
        _suggestingProvider = provider;
        try
        {
            string suggestion;
            try
            {
                suggestion = await ImageNamingService.SuggestNameAsync(aiSettings, item.Image, _selectedPlaylist?.Name, _log.AsProgress(), CancellationToken.None);
            }
            catch (AiNamingException ex)
            {
                _log.Append($"Couldn't suggest a name for \"{item.Name}\": {ex.Message}");
                _toast.ShowError(ex.Message);
                return;
            }

            var updated = await Client.RenameItemAsync(itemId, suggestion);
            await Session.RenameItemAsync(itemId, updated.Name);
            HandleItemRenamed(item, updated);
        }
        catch (Exception ex)
        {
            _log.Append($"Couldn't rename \"{item.Name}\": {ex.Message}");
            _toast.ShowError($"Couldn't rename \"{item.Name}\": {ex.Message}");
        }
        finally
        {
            _suggestingItemId = null;
            _suggestingProvider = null;
        }
    }

    // Same idea as SuggestNameAsync but for the whole current selection at once, applied
    // directly (no review step) - fetch a suggestion per item and rename it right away, politely
    // paced the same as the Meural bulk operations below.
    private async Task AiRenameSelectedAsync()
    {
        var items = _selectedItems
            .Where(i => i.Id is long id && _selectedItemIds.Contains(id) && !string.IsNullOrWhiteSpace(i.Image))
            .ToList();
        if (items.Count == 0)
        {
            _toast.ShowError("None of the selected images have a source URL to analyze.");
            return;
        }

        var aiSettings = await Session.LoadAiSettingsAsync();
        if (!aiSettings.HasKeyFor(aiSettings.Provider))
        {
            _toast.ShowError($"No API key configured for {aiSettings.Provider} - add one in Settings.");
            return;
        }

        _busy = true;
        var cts = _cts = new CancellationTokenSource();
        try
        {
            _log.Append($"AI-renaming {items.Count} image(s) with {aiSettings.Provider}...");
            int done = 0, failed = 0;
            for (var i = 0; i < items.Count; i++)
            {
                var item = (MeuralItem)items[i];
                if (item.Id is not long itemId)
                    continue;

                try
                {
                    var suggestion = await ImageNamingService.SuggestNameAsync(
                        aiSettings, item.Image!, _selectedPlaylist?.Name, _log.AsProgress(), cts.Token);
                    var updated = await Client.RenameItemAsync(itemId, suggestion, cts.Token);
                    await Session.RenameItemAsync(itemId, updated.Name);
                    HandleItemRenamed(item, updated);
                    done++;
                }
                catch (AiNamingException ex)
                {
                    failed++;
                    _log.Append($"[{i + 1}/{items.Count}] Couldn't suggest a name for \"{item.Name}\": {ex.Message}");
                }
                catch (Exception ex)
                {
                    failed++;
                    _log.Append($"[{i + 1}/{items.Count}] Couldn't rename \"{item.Name}\": {ex.Message}");
                }

                if (i < items.Count - 1)
                    await Task.Delay(TimeSpan.FromMilliseconds(300), cts.Token);
            }

            _log.Append($"AI rename finished: {done} renamed, {failed} failed.");
            if (failed > 0)
                _toast.ShowError($"{failed} of {items.Count} image(s) couldn't be renamed.");
            else
                _toast.ShowSuccess($"Renamed {done} image(s).");
        }
        catch (OperationCanceledException)
        {
            HandleCancellation(cts, "AI rename");
        }
        finally
        {
            _cts?.Dispose();
            _cts = null;
            _busy = false;
        }
    }

    private void Cancel() => _cts?.Cancel();

    // Distinguishes the user explicitly clicking Cancel (cts.Token gets cancelled) from the
    // HttpClient request timeout firing on its own (an OperationCanceledException that reports
    // as cancelled without our token ever being cancelled) - the latter is a real failure that
    // deserves a toast, not a silent "Cancelled." nobody sees.
    private void HandleCancellation(CancellationTokenSource cts, string operationLabel)
    {
        if (cts.Token.IsCancellationRequested)
        {
            _log.Append("Cancelled.");
            return;
        }

        _log.Append($"{operationLabel} timed out.");
        _toast.ShowError($"{operationLabel} timed out - the server took too long to respond.");
    }

    private void HandleLogChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _log.Changed -= HandleLogChanged;
        _cts?.Cancel();
        _cts?.Dispose();
        _selectCts?.Cancel();
        _selectCts?.Dispose();
        _splitterRef?.Dispose();
        CleanupFailedUploadsTempDir();
    }
}
