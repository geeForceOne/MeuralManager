    private async Task UploadNewAsync(InputFileChangeEventArgs e)
    {
        if (_selectedPlaylist?.Id is not long galleryId)
            return;

        var files = e.GetMultipleFiles(25);
        if (files.Count == 0)
            return;

        var tempDir = Path.Combine(Path.GetTempPath(), "meuralmanager-web-uploads", Guid.NewGuid().ToString("N"));
        Directory.CreateDirectory(tempDir);
        // Keyed by the path that actually gets uploaded, to a path holding that file's pre-crop
        // bytes (if it was cropped) - so a freshly-uploaded-and-cropped image can be non-
        // destructively reverted too, same as cropping an already-uploaded item.
        var originalPathsByUploadPath = new Dictionary<string, string>();
        var uploadPaths = new List<string>();

        if (!_cropFeatureEnabled)
        {
            foreach (var file in files)
                uploadPaths.Add(await CopyAsIsAsync(file, tempDir));
        }
        else
        {
            // Same crop dialog as the preview pane's "Crop 16:9/9:16" buttons, shown once per
            // picked file before anything is uploaded - fed a blob: URL built client-side
            // straight from the <input>'s own FileList, so cropping a not-yet-uploaded file
            // needs no server round trip. allowSkip offers an "Upload as-is" button here (not
            // shown for the preview-pane replace flow, where there's nothing sensible to upload
            // unmodified), plus - once more than one file is left - an "Upload all as-is"
            // shortcut that skips the crop-or-skip prompt for the rest of the batch. Cancelling
            // a given file's crop just skips that file rather than aborting the batch.
            for (var i = 0; i < files.Count; i++)
            {
                var file = files[i];
                var blobUrl = await JS.InvokeAsync<string?>("meuralCropper.blobUrlForFile", "playlistUploadInput", i);
                if (blobUrl is null)
                    continue;

                CropDialog.CropResult result;
                try
                {
                    result = await _cropDialog.CropAsync(blobUrl, CropDialog.CropAspect.Wide, allowSkip: true, remainingCount: files.Count - i);
                }
                finally
                {
                    await JS.InvokeVoidAsync("meuralCropper.revokeBlobUrl", blobUrl);
                }

                if (result.Outcome == CropDialog.CropOutcome.Cancelled)
                    continue;

                if (result.Outcome == CropDialog.CropOutcome.SkippedAll)
                {
                    for (var j = i; j < files.Count; j++)
                        uploadPaths.Add(await CopyAsIsAsync(files[j], tempDir));
                    break;
                }

                if (result.Outcome == CropDialog.CropOutcome.Applied && result.CroppedPath is string croppedPath)
                {
                    // The crop dialog always exports JPEG, regardless of the original's format.
                    var uploadPath = Path.Combine(tempDir, $"{Path.GetFileNameWithoutExtension(file.Name)}.jpg");
                    File.Move(croppedPath, uploadPath, overwrite: true);

                    var originalPath = Path.Combine(tempDir, $"original-{i}-{file.Name}");
                    await using (var browserStream = file.OpenReadStream(maxAllowedSize: 25_000_000))
                    await using (var fileStream = File.Create(originalPath))
                        await browserStream.CopyToAsync(fileStream);
                    originalPathsByUploadPath[uploadPath] = originalPath;

                    uploadPaths.Add(uploadPath);
                }
                else
                {
                    uploadPaths.Add(await CopyAsIsAsync(file, tempDir));
                }
            }
        }

        if (uploadPaths.Count == 0)
        {
            try { Directory.Delete(tempDir, recursive: true); } catch (IOException) { }
            return;
        }

        _busy = true;
        var cts = _cts = new CancellationTokenSource();
        UploadSummary? summary = null;
        try
        {
            _log.Append($"Uploading {uploadPaths.Count} image(s) to \"{_selectedPlaylist.Name}\"...");
            summary = await PlaylistService.UploadAndAddToGalleryAsync(Client, galleryId, uploadPaths, _log.AsProgress(), cts.Token, KnownItemIds);
            _log.Append($"Finished: {summary.Value.Done} uploaded, {summary.Value.Failed} failed.");
            if (summary.Value.Failed > 0)
                _toast.ShowError($"{summary.Value.Failed} of {uploadPaths.Count} upload(s) failed.");

            foreach (var (path, uploadedItem) in summary.Value.Uploaded)
            {
                if (originalPathsByUploadPath.TryGetValue(path, out var originalPath) && uploadedItem.Id is long newId)
                    Session.SaveUploadOriginal(newId, originalPath);
            }

            await ReloadSelectedItemsAsync(galleryId, cts.Token);
        }
        catch (OperationCanceledException)
        {
            HandleCancellation(cts, "Uploading");
        }
        catch (Exception ex)
        {
            _log.Append($"Upload failed: {ex.Message}");
            _toast.ShowError($"Upload failed: {ex.Message}");
        }
        finally
        {
            // Failed uploads' bytes are kept around (rather than deleted with the rest of
            // tempDir) so the "Retry" panel below can re-upload the exact same file without
            // asking the user to re-pick (and, if applicable, re-crop) it.
            if (summary is { Failures.Count: > 0 })
                TrackFailedUploads(galleryId, tempDir, summary.Value.Failures);
            else
                try { Directory.Delete(tempDir, recursive: true); } catch (IOException) { }

            _cts?.Dispose();
            _cts = null;
            _busy = false;
        }
    }

    private static async Task<string> CopyAsIsAsync(IBrowserFile file, string tempDir)
    {
        // Uploaded as-is - keep the original extension so the content-type Meural is sent
        // (guessed from the file extension) actually matches these bytes.
        var uploadPath = Path.Combine(tempDir, file.Name);
        await using var browserStream = file.OpenReadStream(maxAllowedSize: 25_000_000);
        await using var fileStream = File.Create(uploadPath);
        await browserStream.CopyToAsync(fileStream);
        return uploadPath;
    }

    private void TrackFailedUploads(long galleryId, string tempDir, IReadOnlyList<UploadFailure> failures)
    {
        CleanupFailedUploadsTempDir();
        _failedUploadsGalleryId = galleryId;
        _failedUploadsTempDir = tempDir;
        _failedUploads = failures.Select(f => new FailedUpload(Path.GetFileName(f.FilePath), f.FilePath, f.Error)).ToList();
    }

    private async Task RetryFailedUploadAsync(FailedUpload failure)
    {
        if (_failedUploadsGalleryId is not long galleryId)
            return;

        _busy = true;
        var cts = _cts = new CancellationTokenSource();
        try
        {
            _log.Append($"Retrying upload of \"{failure.FileName}\"...");
            var summary = await PlaylistService.UploadAndAddToGalleryAsync(Client, galleryId, [failure.FilePath], _log.AsProgress(), cts.Token, KnownItemIds);
            if (summary.Done > 0)
            {
                _failedUploads.Remove(failure);
                _toast.ShowSuccess($"Uploaded \"{failure.FileName}\".");
                await ReloadSelectedItemsAsync(galleryId, cts.Token);
            }
            else
            {
                var newError = summary.Failures.Count > 0 ? summary.Failures[0].Error : failure.Error;
                var idx = _failedUploads.FindIndex(f => f.FilePath == failure.FilePath);
                if (idx >= 0)
                    _failedUploads[idx] = failure with { Error = newError };
                _toast.ShowError($"Still couldn't upload \"{failure.FileName}\".");
            }

            if (_failedUploads.Count == 0)
                CleanupFailedUploadsTempDir();
        }
        catch (OperationCanceledException)
        {
            HandleCancellation(cts, "Retry upload");
        }
        finally
        {
            _cts?.Dispose();
            _cts = null;
            _busy = false;
        }
    }

    private async Task RetryAllFailedUploadsAsync()
    {
        if (_failedUploadsGalleryId is not long galleryId || _failedUploads.Count == 0)
            return;

        _busy = true;
        var cts = _cts = new CancellationTokenSource();
        try
        {
            var paths = _failedUploads.Select(f => f.FilePath).ToList();
            _log.Append($"Retrying {paths.Count} failed upload(s)...");
            var summary = await PlaylistService.UploadAndAddToGalleryAsync(Client, galleryId, paths, _log.AsProgress(), cts.Token, KnownItemIds);
            _log.Append($"Retry finished: {summary.Done} uploaded, {summary.Failed} failed.");

            var succeededPaths = summary.Uploaded.Select(u => u.FilePath).ToHashSet();
            var errorByPath = summary.Failures.ToDictionary(f => f.FilePath, f => f.Error);
            _failedUploads = _failedUploads
                .Where(f => !succeededPaths.Contains(f.FilePath))
                .Select(f => errorByPath.TryGetValue(f.FilePath, out var err) ? f with { Error = err } : f)
                .ToList();

            if (summary.Done > 0)
                await ReloadSelectedItemsAsync(galleryId, cts.Token);

            if (_failedUploads.Count == 0)
                CleanupFailedUploadsTempDir();
            else
                _toast.ShowError($"{_failedUploads.Count} upload(s) still failing.");
        }
        catch (OperationCanceledException)
        {
            HandleCancellation(cts, "Retry uploads");
        }
        finally
        {
            _cts?.Dispose();
            _cts = null;
            _busy = false;
        }
    }

