<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MeuralManager.Web</RootNamespace>
    <!-- The version shown in the app (AppInfo.Version). Local builds say "dev"; the Docker build
         passes the release version (-p:InformationalVersion=1.2.0) from the git tag, see the
         Dockerfile and .github/workflows/docker-publish.yml. -->
    <InformationalVersion>dev</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UserSecretsId>meuralmanager-web</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <!-- Forces the SDK to always fetch Blazor's framework JS (blazor.web.js) as a NuGet pack
         instead of relying on the local shared framework install on disk. Needed for
         cross-architecture builds (e.g. building on amd64 for an arm64 target, such as a
         Raspberry Pi) - without it, the on-disk framework is the builder's arch, so the JS is
         silently missing from the target image. See dotnet/aspnetcore#63962. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeuralManager.Core\MeuralManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The release notes page shows the repository's CHANGELOG.md, built into the app. -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="CHANGELOG.md" />
  </ItemGroup>

</Project>
